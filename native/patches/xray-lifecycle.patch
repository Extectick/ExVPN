+func TestExVPNGRPCLifetimePreservesFailedDialSocketCleanupError(t *testing.T) {
+	client, peer := gonet.Pipe()
+	wantCleanup := errors.New("synthetic raw socket close failure")
+	tracked := &lifetimeCloseErrorConn{Conn: client, want: wantCleanup}
+	dialer := &delayedLifetimeDialer{
+		entered: make(chan context.Context, 1), release: make(chan struct{}),
+		conn: tracked, err: errors.New("synthetic dial failure with nonnil connection"),
+	}
+	close(dialer.release)
+	settings := lifetimeConfig(false)
+	internet.UseAlternativeSystemDialer(dialer)
+	t.Cleanup(func() {
+		settings.Close()
+		client.Close()
+		peer.Close()
+		internet.UseAlternativeSystemDialer(nil)
+	})
+	grpcClient, err := getGrpcClient(context.Background(), net.TCPDestination(net.LocalHostIP, 1), settings)
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitLifetime(t, "failed raw dial callback did not finish", func() bool { return grpcClient.GetState() == connectivity.TransientFailure })
+	if err := settings.Close(); !errors.Is(err, wantCleanup) || !errors.Is(settings.Close(), wantCleanup) {
+		t.Fatal("raw socket cleanup error was discarded", err)
+	}
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := peer.Read(make([]byte, 1)); !errors.Is(err, io.EOF) {
+		t.Fatal("nonnil socket returned with a dial error was not closed", err)
+	}
+	if tracked.closes.Load() != 1 || dialer.calls.Load() != 1 || grpcOwnerPresent(settings) {
+		t.Fatal("failed dial ownership was not retired exactly once")
+	}
+}
