diff --git a/common/protocol/tls/sniff_exvpn_test.go b/common/protocol/tls/sniff_exvpn_test.go
new file mode 100644
index 0000000..8bab366
--- /dev/null
+++ b/common/protocol/tls/sniff_exvpn_test.go
@@ -0,0 +1,135 @@
+package tls
+
+import (
+	"context"
+	stdtls "crypto/tls"
+	"encoding/binary"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func exVPNExtension(kind uint16, body []byte) []byte {
+	result := binary.BigEndian.AppendUint16(nil, kind)
+	result = binary.BigEndian.AppendUint16(result, uint16(len(body)))
+	return append(result, body...)
+}
+
+func exVPNSNI(names ...string) []byte {
+	var list []byte
+	for _, name := range names {
+		list = append(list, 0)
+		list = binary.BigEndian.AppendUint16(list, uint16(len(name)))
+		list = append(list, name...)
+	}
+	body := binary.BigEndian.AppendUint16(nil, uint16(len(list)))
+	return exVPNExtension(0, append(body, list...))
+}
+
+func exVPNHello(extensions ...[]byte) []byte {
+	// A bounded TLS 1.2 ClientHello with a single cipher and null compression.
+	body := append([]byte{3, 3}, make([]byte, 32)...)
+	body = append(body, 0, 0, 2, 0xc0, 0x2f, 1, 0)
+	var all []byte
+	for _, extension := range extensions {
+		all = append(all, extension...)
+	}
+	body = binary.BigEndian.AppendUint16(body, uint16(len(all)))
+	body = append(body, all...)
+	hello := []byte{1, byte(len(body) >> 16), byte(len(body) >> 8), byte(len(body))}
+	return append(hello, body...)
+}
+
+func exVPNRecord(hello []byte) []byte {
+	record := []byte{0x16, 3, 3, byte(len(hello) >> 8), byte(len(hello))}
+	return append(record, hello...)
+}
+
+func TestExVPNClientHelloTrustedDomain(t *testing.T) {
+	sni := exVPNSNI("public.example")
+	ech := exVPNExtension(0xfe0d, []byte{0, 0, 1, 0, 1, 7, 0, 0, 0, 0})
+	malformedNames := []byte{0, 0, 14, 'p', 'u', 'b', 'l', 'i', 'c', '.', 'e', 'x', 'a', 'm', 'p', 'l', 'e', 1}
+	malformedSNI := exVPNExtension(0, append(binary.BigEndian.AppendUint16(nil, uint16(len(malformedNames))), malformedNames...))
+	wrongType := exVPNHello(sni)
+	wrongType[0] = 2
+	partialHello := exVPNHello(sni)
+	partialHello[3]++
+	extraHello := append(exVPNHello(sni), 0)
+	cases := []struct {
+		name    string
+		hello   []byte
+		trusted bool
+	}{
+		{"ordinary_sni", exVPNHello(sni), true},
+		{"ordinary_sni_with_trailing_extension", exVPNHello(sni, exVPNExtension(0x0017, nil)), true},
+		{"unrelated_grease_extension", exVPNHello(exVPNExtension(0x2a2a, nil), sni), true},
+		{"ech_before_sni", exVPNHello(ech, sni), false},
+		{"ech_after_sni", exVPNHello(sni, ech), false},
+		{"empty_ech_after_sni", exVPNHello(sni, exVPNExtension(0xfe0d, nil)), false},
+		{"grease_ech_before_sni", exVPNHello(exVPNExtension(0xfe0d, []byte{0xa1, 0xb2, 0xc3}), sni), false},
+		{"partial_trailing_extension_1", exVPNHello(sni, []byte{1}), false},
+		{"partial_trailing_extension_2", exVPNHello(sni, []byte{1, 2}), false},
+		{"partial_trailing_extension_3", exVPNHello(sni, []byte{1, 2, 3}), false},
+		{"truncated_trailing_extension_body", exVPNHello(sni, []byte{0, 17, 0, 5, 1, 2}), false},
+		{"duplicate_sni_extension", exVPNHello(sni, sni), false},
+		{"conflicting_sni_extensions", exVPNHello(sni, exVPNSNI("other.example")), false},
+		{"duplicate_sni_hostname", exVPNHello(exVPNSNI("public.example", "public.example")), false},
+		{"conflicting_sni_hostnames", exVPNHello(exVPNSNI("public.example", "other.example")), false},
+		{"partial_name_after_hostname", exVPNHello(malformedSNI), false},
+		{"empty_hostname", exVPNHello(exVPNSNI("")), false},
+		{"empty_sni_list", exVPNHello(exVPNSNI()), false},
+		{"missing_sni", exVPNHello(exVPNExtension(0x0017, nil)), false},
+		{"wrong_handshake_type", wrongType, false},
+		{"partial_handshake_body", partialHello, false},
+		{"bytes_after_declared_handshake", extraHello, false},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			header := &SniffHeader{domain: "stale.example"}
+			err := ReadClientHello(test.hello, header)
+			if test.trusted {
+				if err != nil || header.Domain() != "public.example" {
+					t.Fatalf("shared parser: domain=%q err=%v", header.Domain(), err)
+				}
+			} else if err == nil || header.Domain() != "" {
+				t.Fatalf("shared parser trusted ambiguous input: domain=%q err=%v", header.Domain(), err)
+			}
+			sniffed, err := SniffTLS(exVPNRecord(test.hello))
+			if test.trusted {
+				if err != nil || sniffed == nil || sniffed.Domain() != "public.example" {
+					t.Fatalf("TLS sniff: header=%v err=%v", sniffed, err)
+				}
+			} else if err == nil || sniffed != nil {
+				t.Fatalf("TLS sniff trusted ambiguous input: header=%v err=%v", sniffed, err)
+			}
+		})
+	}
+}
+
+func TestExVPNClientHelloOrdinaryTLSControl(t *testing.T) {
+	client, server := net.Pipe()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	defer server.Close()
+	defer client.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_ = stdtls.Client(client, &stdtls.Config{ServerName: "public.example", MinVersion: stdtls.VersionTLS13}).HandshakeContext(ctx)
+		_ = client.Close()
+	}()
+	defer func() { _ = server.Close(); <-done }()
+	record := make([]byte, 5)
+	if _, err := io.ReadFull(server, record); err != nil {
+		t.Fatal(err)
+	}
+	body := make([]byte, int(binary.BigEndian.Uint16(record[3:5])))
+	if _, err := io.ReadFull(server, body); err != nil {
+		t.Fatal(err)
+	}
+	header, err := SniffTLS(append(record, body...))
+	if err != nil || header == nil || header.Domain() != "public.example" {
+		t.Fatalf("ordinary crypto/tls control: header=%v err=%v", header, err)
+	}
+}
