diff --git a/proxy/tun/tun_windows_session.go b/proxy/tun/tun_windows_session.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/tun_windows_session.go
@@ -0,0 +1,196 @@
+//go:build windows
+
+// ExVPN modifications. This Source Code Form is subject to the terms of the
+// Mozilla Public License, v. 2.0. See the LICENSE file at the module root.
+
+package tun
+
+import (
+	"errors"
+	"os"
+	"sync"
+	"time"
+
+	"golang.org/x/sys/windows"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+// The interface admits a memory-only test double; the production implementation
+// remains the pinned Wintun session. It does not create or configure an adapter.
+type windowsTunSessionAPI interface {
+	ReceivePacket() ([]byte, error)
+	ReleaseReceivePacket([]byte)
+	AllocateSendPacket(int) ([]byte, error)
+	SendPacket([]byte)
+	End()
+}
+
+type windowsTunSessionEvents interface {
+	wait() error
+	wake() error
+	close() error
+}
+
+type windowsTunEvents struct {
+	read, stop windows.Handle
+}
+
+func newWindowsTunEvents(read windows.Handle) (*windowsTunEvents, error) {
+	if read == 0 {
+		return nil, errors.New("wintun read event is unavailable")
+	}
+	stop, err := windows.CreateEvent(nil, 1, 0, nil)
+	if err != nil {
+		return nil, err
+	}
+	return &windowsTunEvents{read: read, stop: stop}, nil
+}
+
+func (e *windowsTunEvents) wait() error {
+	// Own cancellation event cannot be reset by a concurrent Wintun receive.
+	_, err := windows.WaitForMultipleObjects([]windows.Handle{e.stop, e.read}, false, windows.INFINITE)
+	return err
+}
+
+func (e *windowsTunEvents) wake() error  { return windows.SetEvent(e.stop) }
+func (e *windowsTunEvents) close() error { return windows.CloseHandle(e.stop) }
+
+// ExVPN: admission, native memory and wait handles share one session lifetime.
+// Wintun ReceivePacket is nonblocking; only the explicit event wait can sleep.
+// A failed wake or bounded drain retains the handles instead of ending a
+// session which an unfinished operation could still access.
+type windowsTunSession struct {
+	api          windowsTunSessionAPI
+	events       windowsTunSessionEvents
+	mu           sync.Mutex
+	retired      bool
+	active       int
+	drained      chan struct{}
+	waitErr      error
+	drainTimeout time.Duration
+	retireOnce   sync.Once
+	retireErr    error
+	closeOnce    sync.Once
+	closeErr     error
+}
+
+func newWindowsTunSession(api windowsTunSessionAPI, events windowsTunSessionEvents) *windowsTunSession {
+	return &windowsTunSession{api: api, events: events, drained: make(chan struct{}), drainTimeout: 5 * time.Second}
+}
+
+func (s *windowsTunSession) begin() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.retired {
+		return os.ErrClosed
+	}
+	if s.waitErr != nil {
+		return s.waitErr
+	}
+	s.active++
+	return nil
+}
+
+func (s *windowsTunSession) finish() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.active--
+	if s.retired && s.active == 0 {
+		close(s.drained)
+	}
+}
+
+func (s *windowsTunSession) retire() error {
+	s.retireOnce.Do(func() {
+		s.mu.Lock()
+		s.retired = true
+		if s.active == 0 {
+			close(s.drained)
+		}
+		s.mu.Unlock()
+		// Signal before joining: Wait itself holds an active session lease.
+		if err := s.events.wake(); err != nil {
+			s.retireErr = errors.Join(errors.New("wintun cancellation failed"), err)
+			return
+		}
+		timer := time.NewTimer(s.drainTimeout)
+		defer timer.Stop()
+		select {
+		case <-s.drained:
+		case <-timer.C:
+			s.retireErr = errors.New("wintun session drain timed out")
+		}
+	})
+	return s.retireErr
+}
+
+func (s *windowsTunSession) Close() error {
+	s.closeOnce.Do(func() {
+		if err := s.retire(); err != nil {
+			s.closeErr = err
+			return
+		}
+		s.api.End()
+		s.api = nil
+		// The Wintun read handle belongs to End; only our stop event is ours.
+		s.closeErr = s.events.close()
+	})
+	return s.closeErr
+}
+
+func (s *windowsTunSession) ReadPacket() (byte, *stack.PacketBuffer, error) {
+	if err := s.begin(); err != nil {
+		return 0, nil, err
+	}
+	defer s.finish()
+	packet, err := s.api.ReceivePacket()
+	if errors.Is(err, windows.ERROR_NO_MORE_ITEMS) {
+		return 0, nil, ErrQueueEmpty
+	}
+	if err != nil {
+		return 0, nil, err
+	}
+	if len(packet) == 0 {
+		return 0, nil, windows.ERROR_INVALID_DATA
+	}
+	defer s.api.ReleaseReceivePacket(packet)
+	version := packet[0] >> 4
+	// NewViewWithData already copies. Release native memory before ending the
+	// lease; a retained gVisor packet must never call Wintun from OnRelease.
+	payload := buffer.MakeWithView(buffer.NewViewWithData(packet))
+	return version, stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: payload, IsForwardedPacket: true}), nil
+}
+
+func (s *windowsTunSession) WritePacket(packet *stack.PacketBuffer) tcpip.Error {
+	if err := s.begin(); err != nil {
+		if errors.Is(err, os.ErrClosed) {
+			return &tcpip.ErrClosedForSend{}
+		}
+		return &tcpip.ErrAborted{}
+	}
+	defer s.finish()
+	native, err := s.api.AllocateSendPacket(packet.Size())
+	if err != nil {
+		return &tcpip.ErrAborted{}
+	}
+	var offset int
+	for _, part := range packet.AsSlices() {
+		offset += copy(native[offset:], part)
+	}
+	s.api.SendPacket(native)
+	return nil
+}
+
+func (s *windowsTunSession) Wait() {
+	if s.begin() != nil {
+		return
+	}
+	defer s.finish()
+	if err := s.events.wait(); err != nil {
+		s.mu.Lock()
+		s.waitErr = err
+		s.mu.Unlock()
+	}
+}
