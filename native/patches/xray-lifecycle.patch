@@ -0,0 +1,61 @@
+// ExVPN modifications, Copyright 2026 ExVPN contributors.
+// SPDX-License-Identifier: MPL-2.0
+
+package outbound
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+type lifetimeProxy struct {
+	settings *internet.MemoryStreamConfig
+	closed   atomic.Int32
+	want     error
+	t        *testing.T
+}
+
+func (*lifetimeProxy) Process(context.Context, *transport.Link, internet.Dialer) error { return nil }
+func (p *lifetimeProxy) Close() error {
+	if !p.settings.Lifecycle().IsClosed() || p.settings.Lifecycle().Context().Err() == nil {
+		p.t.Error("proxy closed before transport owner retirement")
+	}
+	p.closed.Add(1)
+	return p.want
+}
+
+func TestExVPNHandlerCloseRetiresTransportOwnerOnce(t *testing.T) {
+	settings := new(internet.MemoryStreamConfig)
+	wantTransport := errors.New("synthetic transport cleanup failure")
+	wantProxy := errors.New("synthetic proxy cleanup failure")
+	var transportCloses atomic.Int32
+	if err := settings.Lifecycle().Register(func() error { transportCloses.Add(1); return wantTransport }); err != nil {
+		t.Fatal(err)
+	}
+	proxy := &lifetimeProxy{settings: settings, want: wantProxy, t: t}
+	h := &Handler{streamSettings: settings, proxy: proxy}
+	var workers sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			err := h.Close()
+			if !errors.Is(err, wantTransport) || !errors.Is(err, wantProxy) {
+				t.Errorf("cleanup errors lost: %v", err)
+			}
+		}()
+	}
+	workers.Wait()
+	if transportCloses.Load() != 1 || proxy.closed.Load() != 1 {
+		t.Fatal("owned resources closed more than once")
+	}
+	if err := settings.Lifecycle().Register(func() error { return nil }); !errors.Is(err, internet.ErrTransportClosed) {
+		t.Fatal("handler close allowed retired cache publication")
+	}
+}
