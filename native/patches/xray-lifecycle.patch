+type delayedLifetimeDialer struct {
+	entered chan context.Context
+	release chan struct{}
+	conn    net.Conn
+	err     error
+	calls   atomic.Int32
+}
+
+func (d *delayedLifetimeDialer) Dial(ctx context.Context, _ net.Address, _ net.Destination, _ *internet.SocketConfig) (net.Conn, error) {
+	d.calls.Add(1)
+	d.entered <- ctx
+	// Intentionally ignore cancellation until released. The transport must join
+	// this callback and close the late result, not return successful retirement.
+	<-d.release
+	return d.conn, d.err
+}
+func (*delayedLifetimeDialer) DestIpAddress() net.IP { return net.LocalHostIP.IP() }
+
+func TestExVPNGRPCLifetimeJoinsPendingDialAndClosesLateSocket(t *testing.T) {
