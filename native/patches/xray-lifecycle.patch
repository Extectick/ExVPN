+package tun
+
+// QA-only regression in a private copy of the exact pinned module. No system
+// TUN, sockets, WFP, DNS configuration, or host routes are created by this file.
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	fdns "github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/features/routing"
+	dnsproxy "github.com/xtls/xray-core/proxy/dns"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"golang.org/x/net/dns/dnsmessage"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+type qaMemoryTun struct{ endpoint *channel.Endpoint }
+
+func (*qaMemoryTun) Start() error                               { return nil }
+func (*qaMemoryTun) Name() (string, error)                      { return "memory-only", nil }
+func (*qaMemoryTun) Index() (int, error)                        { return 1, nil }
+func (t *qaMemoryTun) Close() error                             { t.endpoint.Close(); return nil }
+func (t *qaMemoryTun) newEndpoint() (stack.LinkEndpoint, error) { return t.endpoint, nil }
+
+type qaDNSClient struct{ calls atomic.Int32 }
+
+func (*qaDNSClient) Type() interface{} { return fdns.ClientType() }
+func (*qaDNSClient) Start() error      { return nil }
+func (*qaDNSClient) Close() error      { return nil }
+func (d *qaDNSClient) LookupIP(domain string, option fdns.IPOption) ([]xnet.IP, uint32, error) {
+	if domain != "resource.example.invalid." || !option.IPv4Enable {
+		return nil, 0, errors.New("unexpected synthetic DNS query")
+	}
+	d.calls.Add(1)
+	return []xnet.IP{{198, 18, 0, 9}}, 60, nil
+}
+
+type qaPolicy struct{}
+
+func (qaPolicy) Type() interface{}              { return policy.ManagerType() }
+func (qaPolicy) Start() error                   { return nil }
+func (qaPolicy) Close() error                   { return nil }
+func (qaPolicy) ForLevel(uint32) policy.Session { return policy.SessionDefault() }
+func (qaPolicy) ForSystem() policy.System       { return policy.System{} }
+
+type qaNoDial struct{ calls atomic.Int32 }
+
+func (d *qaNoDial) Dial(context.Context, xnet.Destination) (stat.Connection, error) {
+	d.calls.Add(1)
+	return nil, errors.New("real socket forbidden in memory-only QA")
+}
+func (*qaNoDial) DestIpAddress() xnet.IP                                { return nil }
+func (*qaNoDial) SetOutboundGateway(context.Context, *session.Outbound) {}
+
+type qaReadWitness struct {
+	buf.Reader
+	ended chan struct{}
+	once  sync.Once
+}
+
+func (r *qaReadWitness) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	b, err := r.Reader.ReadMultiBuffer()
+	if err != nil {
+		r.once.Do(func() { close(r.ended) })
+	}
+	return b, err
+}
+
+type qaDNSDispatcher struct {
+	handler    *dnsproxy.Handler
+	dialer     *qaNoDial
+	ctx        context.Context
+	done       chan struct{}
+	readerDone chan struct{}
+}
+
+func (*qaDNSDispatcher) Type() interface{} { return routing.DispatcherType() }
+func (*qaDNSDispatcher) Start() error      { return nil }
+func (*qaDNSDispatcher) Close() error      { return nil }
+func (*qaDNSDispatcher) Dispatch(context.Context, xnet.Destination) (*transport.Link, error) {
+	return nil, errors.New("unexpected Dispatch")
+}
+func (d *qaDNSDispatcher) DispatchLink(ctx context.Context, dest xnet.Destination, link *transport.Link) error {
+	defer close(d.done)
+	// A separately cancellable parent is solely a positive-control/cleanup aid.
+	// The regression never cancels it before measuring Handler.Close.
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(d.ctx, cancel)
+	defer stop()
+	defer cancel()
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: dest}})
+	link.Reader = &qaReadWitness{Reader: link.Reader, ended: d.readerDone}
+	return d.handler.Process(ctx, link, d.dialer)
+}
+
+func qaDNSFixture(t *testing.T) (*Handler, *qaDNSDispatcher, context.CancelFunc) {
+	t.Helper()
+	dnsClient := &qaDNSClient{}
+	proxy := &dnsproxy.Handler{}
+	if err := proxy.Init(&dnsproxy.Config{}, dnsClient, qaPolicy{}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	dispatcher := &qaDNSDispatcher{handler: proxy, dialer: &qaNoDial{}, ctx: ctx, done: make(chan struct{}), readerDone: make(chan struct{})}
+	tun := &qaMemoryTun{endpoint: channel.New(8, 1500, "")}
+	instance, err := core.New(&core.Config{})
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = instance.Close() })
+	if err := instance.AddFeature(dispatcher); err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	created, err := core.CreateObject(instance, &Config{})
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	handler := created.(*Handler)
+	handler.tun = tun
+	gvisor := &stackGVisor{ctx: handler.ctx, tun: tun, handler: handler}
+	handler.stack = gvisor
+	if err := gvisor.Start(); err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		cancel()
+		_ = handler.Close()
+		select {
+		case <-dispatcher.done:
+		case <-time.After(time.Second):
+			t.Error("cleanup failed to stop DNS handler")
+		}
+		select {
+		case <-dispatcher.readerDone:
+		case <-time.After(time.Second):
+			t.Error("cleanup failed to stop UDP reader")
+		}
+		if dispatcher.dialer.calls.Load() != 0 {
+			t.Error("test attempted an external dial")
+		}
+	})
+	query := dnsmessage.Message{
+		Header:    dnsmessage.Header{ID: 17, RecursionDesired: true},
+		Questions: []dnsmessage.Question{{Name: dnsmessage.MustNewName("resource.example.invalid."), Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET}},
+	}
+	dnsBytes, err := query.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := make([]byte, header.IPv4MinimumSize+header.UDPMinimumSize+len(dnsBytes))
+	ip := header.IPv4(raw)
+	ip.Encode(&header.IPv4Fields{TotalLength: uint16(len(raw)), TTL: 64, Protocol: uint8(header.UDPProtocolNumber), SrcAddr: tcpip.AddrFrom4([4]byte{198, 18, 0, 1}), DstAddr: tcpip.AddrFrom4([4]byte{198, 18, 0, 2})})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	udp := header.UDP(raw[header.IPv4MinimumSize:])
+	udp.Encode(&header.UDPFields{SrcPort: 41001, DstPort: 53, Length: uint16(header.UDPMinimumSize + len(dnsBytes))})
+	copy(raw[header.IPv4MinimumSize+header.UDPMinimumSize:], dnsBytes)
+	packet := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(raw)})
+	tun.endpoint.InjectInbound(header.IPv4ProtocolNumber, packet)
+	packet.DecRef()
+	readCtx, stop := context.WithTimeout(context.Background(), 2*time.Second)
+	defer stop()
+	response := tun.endpoint.ReadContext(readCtx)
+	if response == nil {
+		t.Fatal("no synthetic DNS response; close assertion not reached")
+	}
+	view := response.ToView()
+	responseBytes := append([]byte{}, view.AsSlice()...)
+	view.Release()
+	response.DecRef()
+	var parsed dnsmessage.Message
+	if len(responseBytes) < 28 || parsed.Unpack(responseBytes[28:]) != nil || !parsed.Header.Response || parsed.Header.ID != 17 || len(parsed.Answers) != 1 || dnsClient.calls.Load() != 1 {
+		t.Fatal("synthetic DNS response did not prove active real DNS handler")
+	}
+	select {
+	case <-dispatcher.done:
+		t.Fatal("DNS handler ended before Close")
+	default:
+	}
+	t.Log("positive control: real gVisor UDP -> TUN Handler -> DNS Handler returned one DNS answer without any socket")
+	return handler, dispatcher, cancel
+}
+
+func TestExVPNQAParentCancelStopsDNSHandler(t *testing.T) {
+	_, dispatcher, cancel := qaDNSFixture(t)
+	cancel()
+	select {
+	case <-dispatcher.done:
+	case <-time.After(time.Second):
+		t.Fatal("explicit parent cancellation did not stop DNS handler")
+	}
+}
+
+func TestExVPNQATunCloseStopsDNSHandler(t *testing.T) {
+	handler, dispatcher, _ := qaDNSFixture(t)
+	if err := handler.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-dispatcher.done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("TUN Handler.Close returned, but its answered DNS/UDP handler is still alive; cleanup parent cancellation follows only after this failure")
+	}
+}
