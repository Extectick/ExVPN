+func TestExVPNQAPartialLifecycleCannotResurrectClosedHandler(t *testing.T) {
+	for _, initialized := range []bool{false, true} {
+		handler := &Handler{config: &Config{}}
+		if initialized {
+			handler, _, _ = qaStartupFixture(t)
+		}
+		if err := handler.Close(); err != nil {
+			t.Fatal(err)
+		}
+		called := false
+		if err := handler.start(func(*Config) (Tun, error) { called = true; return nil, nil }); err == nil || called {
+			t.Fatal("Start created a resource after Close")
+		}
+		if err := handler.Init(context.Background(), qaPolicy{}, &qaStartupDispatcher{}); err == nil {
+			t.Fatal("Init resurrected a closed handler")
+		}
+	}
+	partial := &Handler{}
+	called := false
+	if err := partial.start(func(*Config) (Tun, error) { called = true; return nil, nil }); err == nil || called {
+		t.Fatal("uninitialized Start created a resource")
+	}
+	if err := partial.Init(nil, nil, nil); err == nil {
+		t.Fatal("invalid Init succeeded")
+	}
+	if err := partial.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestExVPNQACloseConcurrentWithStartup(t *testing.T) {
+	handler, tun, dispatcher := qaStartupFixture(t)
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	tun.start = func() error {
+		if err := qaInjectStartupPacket(tun, dispatcher); err != nil {
+			return err
+		}
+		close(entered)
+		<-release
+		return nil
+	}
+	started := make(chan error, 1)
+	go func() { started <- handler.start(func(*Config) (Tun, error) { return tun, nil }) }()
+	select {
+	case <-entered:
+	case <-time.After(2 * time.Second):
+		close(release)
+		t.Fatal("startup positive control did not complete")
+	}
+	closed := make(chan error, 8)
+	for i := 0; i < 8; i++ {
+		go func() { closed <- handler.Close() }()
+	}
+	select {
+	case <-closed:
+		close(release)
+		t.Fatal("Close escaped an unpublished startup resource")
+	default:
+	}
+	close(release)
+	if err := <-started; err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 8; i++ {
+		select {
+		case err := <-closed:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("concurrent startup/Close did not complete")
+		}
+	}
+	if tun.closes.Load() != 1 || handler.ctx.Err() == nil {
+		t.Fatal("concurrent Close did not retire the started resource once")
+	}
+	select {
+	case <-dispatcher.done:
+	default:
+		t.Fatal("Close returned before startup worker ended")
+	}
+}
