+	owner := globalDialerOwners[settings]
+	if owner != nil {
+		owner.mu.Lock()
+		owner.closed = true
+		owner.mu.Unlock()
+	}
+	var clients []*grpc.ClientConn
+	for key, client := range globalDialerMap {
+		if key.MemoryStreamConfig == settings {
+			delete(globalDialerMap, key)
+			clients = append(clients, client)
+		}
+	}
+	delete(globalDialerOwners, settings)
+	globalDialerAccess.Unlock()
+	var errs []error
+	for _, client := range clients {
+		if client != nil && client.GetState() != connectivity.Shutdown {
+			if err := client.Close(); err != nil && !goerrors.Is(err, grpc.ErrClientConnClosing) {
