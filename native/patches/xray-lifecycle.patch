+// The peer reads a real REALITY ClientHello, then either rejects it with a TLS
+// alert or stalls until the owner retires. EOF proves that the callback did not
+// orphan the raw socket before handing any transport to grpc-go.
+func startLifetimeRealityPeer(t *testing.T, reject bool) (net.Destination, <-chan error, <-chan error) {
+	t.Helper()
+	listener, err := gonet.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	hello := make(chan error, 1)
+	eof := make(chan error, 1)
+	accepted := make(chan gonet.Conn, 1)
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		conn, err := listener.Accept()
+		if err != nil {
+			hello <- err
+			return
+		}
+		accepted <- conn
+		defer conn.Close()
+		_ = listener.Close() // This fixture owns exactly one handshake.
+		_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+		header := make([]byte, 5)
+		if _, err := io.ReadFull(conn, header); err != nil {
+			hello <- err
+			return
+		}
+		size := binary.BigEndian.Uint16(header[3:])
+		if header[0] != 22 || size == 0 || size > 16384 {
+			hello <- errors.New("peer did not receive a TLS handshake record")
+			return
+		}
+		if _, err := io.CopyN(io.Discard, conn, int64(size)); err != nil {
+			hello <- err
+			return
+		}
+		if reject {
+			// TLS fatal handshake_failure. Keep the TCP socket open so a missing
+			// client-side Close remains independently visible at the peer.
+			if _, err := conn.Write([]byte{21, 3, 3, 0, 2, 2, 40}); err != nil {
+				hello <- err
+				return
+			}
+		}
+		hello <- nil
+		_, err = conn.Read(make([]byte, 1))
+		eof <- err
+	}()
+	t.Cleanup(func() {
+		listener.Close()
+		select {
+		case conn := <-accepted:
+			conn.Close()
+		default:
+		}
+		<-finished
+	})
+	return net.TCPDestination(net.LocalHostIP, net.Port(listener.Addr().(*gonet.TCPAddr).Port)), hello, eof
+}
+
+func TestExVPNGRPCLifetimeClosesFailedAndStalledRealityHandshake(t *testing.T) {
+	for _, reject := range []bool{true, false} {
+		t.Run(map[bool]string{true: "failed", false: "stalled"}[reject], func(t *testing.T) {
+			dest, hello, eof := startLifetimeRealityPeer(t, reject)
+			settings := lifetimeRealityConfig(t)
+			t.Cleanup(func() { settings.Close() })
+			client, err := getGrpcClient(context.Background(), dest, settings)
+			if err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case err := <-hello:
+				if err != nil {
+					t.Fatal("REALITY ClientHello failed", err)
+				}
+			case <-time.After(2 * time.Second):
+				t.Fatal("REALITY handshake did not start")
+			}
+			if reject {
+				waitLifetime(t, "failed REALITY callback did not finish", func() bool { return client.GetState() == connectivity.TransientFailure })
+			}
+			closed := make(chan error, 1)
+			go func() { closed <- settings.Close() }()
+			select {
+			case err := <-closed:
+				if err != nil {
+					t.Fatal("retirement failed", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("retirement did not cancel and join the REALITY handshake")
+			}
+			select {
+			case err := <-eof:
+				if !errors.Is(err, io.EOF) {
+					t.Fatal("raw REALITY socket survived callback failure/retirement", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("peer did not observe retired REALITY socket EOF")
+			}
+			if client.GetState() != connectivity.Shutdown || grpcOwnerPresent(settings) {
+				t.Fatal("failed REALITY owner remained cached")
+			}
+		})
+	}
+}
