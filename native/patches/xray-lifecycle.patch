+// ExVPN modification: ClientConn.Close cancels background attempts but the
+// system dialer may still be returning a socket. Join those callbacks before
+// owner cleanup completes, and serialize Add against the start of Wait.
+type grpcDialerOwner struct {
+	mu       sync.Mutex
+	closed   bool
+	pending  sync.WaitGroup
+	lifetime *internet.TransportLifetime
+	// Keep the first failed raw-socket cleanup until retirement. This remains
+	// bounded even when an unavailable endpoint triggers many background tries.
+	cleanupErr error
+}
+
+func (o *grpcDialerOwner) begin() bool {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.lifetime.IsClosed() {
+		return false
+	}
+	o.pending.Add(1)
+	return true
+}
+
+func (o *grpcDialerOwner) closeFailedSocket(conn net.Conn) error {
+	err := conn.Close()
+	// A canceled TLS handshake can already have closed the same raw socket.
+	if goerrors.Is(err, gonet.ErrClosed) {
+		return nil
+	}
+	if err != nil {
+		o.mu.Lock()
+		if o.cleanupErr == nil {
+			o.cleanupErr = err
+		}
+		o.mu.Unlock()
+	}
+	return err
+}
+
+// ExVPN modification: detach only this config's clients under the cache mutex,
+// then close transports outside it. Closing one core cannot affect a live core.
+func closeGrpcOwner(settings *internet.MemoryStreamConfig) error {
+	globalDialerAccess.Lock()
+	owner := globalDialerOwners[settings]
+	if owner != nil {
+		owner.mu.Lock()
+		owner.closed = true
+		owner.mu.Unlock()
+	}
+	var clients []*grpc.ClientConn
+	for key, client := range globalDialerMap {
+		if key.MemoryStreamConfig == settings {
+			delete(globalDialerMap, key)
+			clients = append(clients, client)
+		}
+	}
+	delete(globalDialerOwners, settings)
+	globalDialerAccess.Unlock()
+	var errs []error
+	for _, client := range clients {
+		if client != nil && client.GetState() != connectivity.Shutdown {
+			if err := client.Close(); err != nil && !goerrors.Is(err, grpc.ErrClientConnClosing) {
+				errs = append(errs, err)
+			}
+		}
+	}
+	if owner != nil {
+		owner.pending.Wait()
+		owner.mu.Lock()
+		errs = append(errs, owner.cleanupErr)
+		owner.mu.Unlock()
+	}
+	return goerrors.Join(errs...)
+}
