diff --git a/transport/internet/transport_lifetime.go b/transport/internet/transport_lifetime.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/transport_lifetime.go
@@ -0,0 +1,120 @@
+// ExVPN modifications, Copyright 2026 ExVPN contributors.
+// SPDX-License-Identifier: MPL-2.0
+
+package internet
+
+import (
+	"context"
+	"errors"
+	"sync"
+)
+
+// ErrTransportClosed rejects new resources belonging to a retired stream owner.
+var ErrTransportClosed = errors.New("transport owner is closed")
+
+// Protects only lazy owner pointer initialization; it does not retain configs.
+// A MemoryStreamConfig must not be copied concurrently with its first use.
+var memoryStreamLifetimeAccess sync.Mutex
+
+// Lifecycle returns the stable lifetime of this parsed stream configuration.
+// Configurations derived before publication can share this pointer explicitly.
+func (s *MemoryStreamConfig) Lifecycle() *TransportLifetime {
+	memoryStreamLifetimeAccess.Lock()
+	defer memoryStreamLifetimeAccess.Unlock()
+	if s.transportLifetime == nil {
+		ctx, cancel := context.WithCancel(context.Background())
+		s.transportLifetime = &TransportLifetime{ctx: ctx, cancel: cancel, done: make(chan struct{})}
+	}
+	return s.transportLifetime
+}
+
+// ShareTransportLifetime attaches an unused derived config to its parent's
+// owner. Call before publishing the child. A previously used owner cannot be
+// replaced or resurrected, including when that owner has already closed.
+func (s *MemoryStreamConfig) ShareTransportLifetime(parent *MemoryStreamConfig) error {
+	if s == nil || parent == nil {
+		return errors.New("transport owner is missing")
+	}
+	owner := parent.Lifecycle()
+	memoryStreamLifetimeAccess.Lock()
+	defer memoryStreamLifetimeAccess.Unlock()
+	if s.transportLifetime != nil && s.transportLifetime != owner {
+		return errors.New("transport owner is already initialized")
+	}
+	s.transportLifetime = owner
+	return nil
+}
+
+// Close retires this config and every derived config sharing its lifetime.
+func (s *MemoryStreamConfig) Close() error {
+	if s == nil {
+		return nil
+	}
+	return s.Lifecycle().Close()
+}
+
+// TransportLifetime owns transport caches and their background work. A cache
+// may hold its mutex while calling Register or IsClosed. Close never invokes
+// callbacks under this lifetime's mutex, so callbacks may acquire cache locks.
+// The zero value is not usable; obtain an instance through Lifecycle.
+type TransportLifetime struct {
+	mu      sync.Mutex
+	ctx     context.Context
+	cancel  context.CancelFunc
+	closed  bool
+	closers []func() error
+	done    chan struct{}
+	err     error
+}
+
+// Context is canceled as soon as retirement begins, before resource closers.
+func (l *TransportLifetime) Context() context.Context { return l.ctx }
+
+func (l *TransportLifetime) IsClosed() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.closed
+}
+
+// Register transfers a closer to this owner. On rejection the caller retains
+// responsibility for cleanup; the callback is never invoked synchronously.
+// A callback must not recursively Close its own lifetime or wait for that Close.
+func (l *TransportLifetime) Register(closer func() error) error {
+	if closer == nil {
+		return errors.New("transport closer is missing")
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.closed {
+		return ErrTransportClosed
+	}
+	l.closers = append(l.closers, closer)
+	return nil
+}
+
+// Close is idempotent and joins all registered closers. Concurrent callers wait
+// for the same cleanup and receive its stable error. Registration is forbidden
+// from the moment closed is set, so delayed dials cannot revive this owner.
+func (l *TransportLifetime) Close() error {
+	l.mu.Lock()
+	if l.closed {
+		done := l.done
+		l.mu.Unlock()
+		<-done
+		return l.err
+	}
+	l.closed = true
+	closers := l.closers
+	l.closers = nil
+	l.mu.Unlock()
+	l.cancel()
+	var errs []error
+	for _, closer := range closers {
+		if err := closer(); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	l.err = errors.Join(errs...)
+	close(l.done)
+	return l.err
+}
diff --git a/transport/internet/transport_lifetime_test.go b/transport/internet/transport_lifetime_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/transport_lifetime_test.go
@@ -0,0 +1,160 @@
+// ExVPN modifications, Copyright 2026 ExVPN contributors.
+// SPDX-License-Identifier: MPL-2.0
+
+package internet
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestExVPNTransportLifetimeCloseJoinsAndCancels(t *testing.T) {
+	settings := new(MemoryStreamConfig)
+	lifetime := settings.Lifecycle()
+	want := errors.New("synthetic close failure")
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var calls atomic.Int32
+	if err := lifetime.Register(func() error {
+		calls.Add(1)
+		if !lifetime.IsClosed() || !errors.Is(lifetime.Context().Err(), context.Canceled) {
+			t.Error("cleanup ran before owner retirement/cancellation")
+		}
+		close(entered)
+		<-release
+		return want
+	}); err != nil {
+		t.Fatal(err)
+	}
+	first := make(chan error, 1)
+	go func() { first <- settings.Close() }()
+	<-entered
+	second := make(chan error, 1)
+	go func() { second <- settings.Close() }()
+	select {
+	case <-second:
+		t.Fatal("concurrent Close returned before owned cleanup finished")
+	case <-time.After(20 * time.Millisecond):
+	}
+	lateCalled := false
+	if err := lifetime.Register(func() error { lateCalled = true; return nil }); !errors.Is(err, ErrTransportClosed) || lateCalled {
+		t.Fatal("late registration was accepted or executed synchronously")
+	}
+	close(release)
+	if !errors.Is(<-first, want) || !errors.Is(<-second, want) || !errors.Is(settings.Close(), want) || calls.Load() != 1 {
+		t.Fatal("Close did not preserve the one completed cleanup result")
+	}
+}
+
+func TestExVPNTransportLifetimeRegisterCloseRace(t *testing.T) {
+	for round := 0; round < 100; round++ {
+		settings := new(MemoryStreamConfig)
+		lifetime := settings.Lifecycle()
+		var accepted, cleaned atomic.Int32
+		start := make(chan struct{})
+		var workers sync.WaitGroup
+		for i := 0; i < 12; i++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				<-start
+				err := lifetime.Register(func() error { cleaned.Add(1); return nil })
+				if err == nil {
+					accepted.Add(1)
+				} else if !errors.Is(err, ErrTransportClosed) {
+					t.Errorf("unexpected registration failure: %v", err)
+				}
+			}()
+		}
+		workers.Add(1)
+		go func() { defer workers.Done(); <-start; _ = settings.Close() }()
+		close(start)
+		workers.Wait()
+		if err := settings.Close(); err != nil || cleaned.Load() != accepted.Load() {
+			t.Fatalf("lost or duplicated cleanup: accepted=%d cleaned=%d err=%v", accepted.Load(), cleaned.Load(), err)
+		}
+	}
+}
+
+func TestExVPNTransportLifetimeSharingAndLazyInitialization(t *testing.T) {
+	parent := new(MemoryStreamConfig)
+	owners := make(chan *TransportLifetime, 32)
+	var workers sync.WaitGroup
+	for i := 0; i < cap(owners); i++ {
+		workers.Add(1)
+		go func() { defer workers.Done(); owners <- parent.Lifecycle() }()
+	}
+	workers.Wait()
+	close(owners)
+	for owner := range owners {
+		if owner != parent.Lifecycle() {
+			t.Fatal("one config acquired multiple lifetimes")
+		}
+	}
+	child := new(MemoryStreamConfig)
+	if err := child.ShareTransportLifetime(parent); err != nil || child.Lifecycle() != parent.Lifecycle() {
+		t.Fatal("download config did not share owner", err)
+	}
+	copyOfParent := *parent // no copied mutex or Once; a stable owner pointer.
+	if copyOfParent.Lifecycle() != parent.Lifecycle() {
+		t.Fatal("parsed config copy lost its initialized owner")
+	}
+	if err := parent.Close(); err != nil || !child.Lifecycle().IsClosed() || !copyOfParent.Lifecycle().IsClosed() {
+		t.Fatal("derived configs survived parent retirement", err)
+	}
+	if err := child.ShareTransportLifetime(new(MemoryStreamConfig)); err == nil {
+		t.Fatal("retired owner was replaced")
+	}
+	lateChild := new(MemoryStreamConfig)
+	if err := lateChild.ShareTransportLifetime(parent); err != nil || !lateChild.Lifecycle().IsClosed() {
+		t.Fatal("late derived config resurrected retired parent", err)
+	}
+	if err := parent.Lifecycle().Register(nil); err == nil {
+		t.Fatal("nil closer accepted")
+	}
+	var missing *MemoryStreamConfig
+	if err := missing.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := child.ShareTransportLifetime(nil); err == nil {
+		t.Fatal("missing parent accepted")
+	}
+}
+
+func TestExVPNTransportLifetimeCacheLockOrder(t *testing.T) {
+	settings := new(MemoryStreamConfig)
+	var cache sync.Mutex
+	cache.Lock()
+	removed := false
+	if err := settings.Lifecycle().Register(func() error {
+		cache.Lock()
+		defer cache.Unlock()
+		removed = true
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- settings.Close() }()
+	select {
+	case <-settings.Lifecycle().Context().Done():
+	case <-time.After(time.Second):
+		t.Fatal("retirement held lifetime lock while waiting on cache")
+	}
+	if err := settings.Lifecycle().Register(func() error { return nil }); !errors.Is(err, ErrTransportClosed) {
+		t.Fatal("retired cache owner accepted publication")
+	}
+	cache.Unlock()
+	select {
+	case err := <-closed:
+		if err != nil || !removed {
+			t.Fatal("cache cleanup failed", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cache/lifetime lock inversion")
+	}
+}
diff --git a/proxy/tun/exvpn_windows_session_test.go b/proxy/tun/exvpn_windows_session_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/exvpn_windows_session_test.go
@@ -0,0 +1,516 @@
+//go:build windows
+
+// ExVPN modifications. This Source Code Form is subject to the terms of the
+// Mozilla Public License, v. 2.0. See the LICENSE file at the module root.
+
+package tun
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+type qaWindowsSession struct {
+	callAfterEnd                                               bool
+	mu                                                         sync.Mutex
+	packet                                                     []byte
+	ended                                                      bool
+	releases, ends, receives, allocations, sends, nativeActive int
+	releaseAfterEnd, endWhileActive                            bool
+	receiveGate, releaseGate, sendGate                         func()
+	receiveErr                                                 error
+}
+
+func (s *qaWindowsSession) ReceivePacket() ([]byte, error) {
+	s.mu.Lock()
+	s.receives++
+	s.callAfterEnd = s.callAfterEnd || s.ended
+	s.nativeActive++
+	s.mu.Unlock()
+	if s.receiveGate != nil {
+		s.receiveGate()
+	}
+	s.mu.Lock()
+	s.nativeActive--
+	packet := append([]byte(nil), s.packet...)
+	s.mu.Unlock()
+	return packet, s.receiveErr
+}
+func (s *qaWindowsSession) ReleaseReceivePacket(packet []byte) {
+	s.mu.Lock()
+	s.nativeActive++
+	s.mu.Unlock()
+	if s.releaseGate != nil {
+		s.releaseGate()
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.nativeActive--
+	s.releases++
+	s.releaseAfterEnd = s.releaseAfterEnd || s.ended
+	for i := range packet {
+		packet[i] = 0xff
+	}
+}
+func (s *qaWindowsSession) AllocateSendPacket(n int) ([]byte, error) {
+	s.mu.Lock()
+	s.allocations++
+	s.callAfterEnd = s.callAfterEnd || s.ended
+	s.mu.Unlock()
+	return make([]byte, n), nil
+}
+func (s *qaWindowsSession) SendPacket([]byte) {
+	s.mu.Lock()
+	s.nativeActive++
+	s.callAfterEnd = s.callAfterEnd || s.ended
+	s.mu.Unlock()
+	if s.sendGate != nil {
+		s.sendGate()
+	}
+	s.mu.Lock()
+	s.nativeActive--
+	s.sends++
+	s.mu.Unlock()
+}
+func (s *qaWindowsSession) End() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ended = true
+	s.ends++
+	s.endWhileActive = s.endWhileActive || s.nativeActive != 0
+}
+
+type qaWindowsEvents struct {
+	mu                               sync.Mutex
+	wakeCount, closeCount, waitCount int
+	wakeErr, closeErr, waitErr       error
+	woken                            chan struct{}
+	waitEntered                      chan struct{}
+	waitExit                         <-chan struct{}
+}
+
+func newQAWindowsEvents() *qaWindowsEvents { return &qaWindowsEvents{woken: make(chan struct{})} }
+func (e *qaWindowsEvents) wake() error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.wakeCount++
+	if e.wakeErr != nil {
+		return e.wakeErr
+	}
+	close(e.woken)
+	return nil
+}
+func (e *qaWindowsEvents) wait() error {
+	e.mu.Lock()
+	e.waitCount++
+	e.mu.Unlock()
+	if e.waitEntered != nil {
+		close(e.waitEntered)
+	}
+	if e.waitErr != nil {
+		return e.waitErr
+	}
+	<-e.woken
+	if e.waitExit != nil {
+		<-e.waitExit
+	}
+	return nil
+}
+func (e *qaWindowsEvents) close() error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.closeCount++
+	return e.closeErr
+}
+func qaAwait(t *testing.T, event <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-event:
+	case <-time.After(2 * time.Second):
+		t.Fatal("test barrier timed out")
+	}
+}
+func qaWindowsPacket() *stack.PacketBuffer {
+	return stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithView(buffer.NewViewWithData([]byte{0x45, 1, 2, 3}))})
+}
+
+func TestExVPNWindowsTunPacketOutlivesClose(t *testing.T) {
+	want := []byte{0x45, 1, 2, 3}
+	session := &qaWindowsSession{packet: append([]byte(nil), want...)}
+	// No adapter, LUID, routes, DNS, callback or WFP handle is installed.
+	tun := &WindowsTun{options: &Config{}, session: newWindowsTunSession(session, newQAWindowsEvents())}
+	version, packet, err := tun.ReadPacket()
+	if err != nil || version != 4 || packet == nil {
+		t.Fatalf("ReadPacket: version=%d err=%v", version, err)
+	}
+	if err := tun.Close(); err != nil {
+		t.Fatal(err)
+	}
+	var got []byte
+	for _, part := range packet.AsSlices() {
+		got = append(got, part...)
+	}
+	packet.DecRef()
+	if !bytes.Equal(got, want) {
+		t.Fatal("retained packet aliases native storage")
+	}
+	session.mu.Lock()
+	defer session.mu.Unlock()
+	if session.ends != 1 || session.releases != 1 || session.releaseAfterEnd {
+		t.Fatalf("unsafe session order: End=%d Release=%d ReleaseAfterEnd=%t", session.ends, session.releases, session.releaseAfterEnd)
+	}
+}
+
+func TestExVPNWindowsSessionCloseJoinsNativeOperations(t *testing.T) {
+	for _, operation := range []string{"receive", "release", "send", "wait"} {
+		t.Run(operation, func(t *testing.T) {
+			entered, allow := make(chan struct{}), make(chan struct{})
+			gate := func() { close(entered); <-allow }
+			session := &qaWindowsSession{packet: []byte{0x45, 1, 2, 3}}
+			events := newQAWindowsEvents()
+			switch operation {
+			case "receive":
+				session.receiveGate = gate
+			case "release":
+				session.releaseGate = gate
+			case "send":
+				session.sendGate = gate
+			case "wait":
+				events.waitEntered = entered
+				events.waitExit = allow
+			}
+			owner := newWindowsTunSession(session, events)
+			opDone := make(chan struct{})
+			go func() {
+				defer close(opDone)
+				if operation == "wait" {
+					owner.Wait()
+					return
+				}
+				if operation == "send" {
+					p := qaWindowsPacket()
+					defer p.DecRef()
+					if owner.WritePacket(p) != nil {
+						t.Error("write failed")
+					}
+					return
+				}
+				_, p, err := owner.ReadPacket()
+				if err != nil {
+					t.Error(err)
+				}
+				if p != nil {
+					p.DecRef()
+				}
+			}()
+			qaAwait(t, entered)
+			closeDone := make(chan struct{})
+			go func() {
+				defer close(closeDone)
+				if err := owner.Close(); err != nil {
+					t.Error(err)
+				}
+			}()
+			qaAwait(t, events.woken)
+			if _, _, err := owner.ReadPacket(); !errors.Is(err, os.ErrClosed) {
+				t.Error("retiring owner admitted another receive")
+			}
+			late := qaWindowsPacket()
+			if owner.WritePacket(late) == nil {
+				t.Error("retiring owner admitted another send")
+			}
+			late.DecRef()
+			owner.Wait()
+			session.mu.Lock()
+			ends := session.ends
+			session.mu.Unlock()
+			events.mu.Lock()
+			handlesClosed := events.closeCount
+			events.mu.Unlock()
+			if ends != 0 || handlesClosed != 0 {
+				t.Error("session or event ended before operation completion")
+			}
+			close(allow)
+			qaAwait(t, opDone)
+			qaAwait(t, closeDone)
+			session.mu.Lock()
+			defer session.mu.Unlock()
+			if session.ends != 1 || session.endWhileActive || session.releaseAfterEnd {
+				t.Fatal("native lifetime order violated")
+			}
+		})
+	}
+}
+
+func TestExVPNWindowsSessionCloseFailureRetainsLiveHandles(t *testing.T) {
+	t.Run("wake", func(t *testing.T) {
+		fault := errors.New("wake failure")
+		events := newQAWindowsEvents()
+		events.wakeErr = fault
+		session := &qaWindowsSession{}
+		owner := newWindowsTunSession(session, events)
+		first := owner.Close()
+		if !errors.Is(first, fault) || owner.Close() != first {
+			t.Fatal("wake failure was not retained")
+		}
+		if session.ends != 0 || events.closeCount != 0 || events.wakeCount != 1 {
+			t.Fatal("failed wake freed native handles or was retried")
+		}
+		if _, _, err := owner.ReadPacket(); !errors.Is(err, os.ErrClosed) {
+			t.Fatal("failed retirement reopened admission")
+		}
+	})
+	t.Run("drain", func(t *testing.T) {
+		entered, allow := make(chan struct{}), make(chan struct{})
+		session := &qaWindowsSession{packet: []byte{0x45}, receiveGate: func() { close(entered); <-allow }}
+		events := newQAWindowsEvents()
+		owner := newWindowsTunSession(session, events)
+		owner.drainTimeout = 20 * time.Millisecond
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			_, p, _ := owner.ReadPacket()
+			if p != nil {
+				p.DecRef()
+			}
+		}()
+		qaAwait(t, entered)
+		first := owner.Close()
+		if first == nil || owner.Close() != first {
+			t.Error("drain failure was not retained")
+		}
+		session.mu.Lock()
+		ends := session.ends
+		session.mu.Unlock()
+		if ends != 0 || events.closeCount != 0 {
+			t.Error("timeout ended an active session")
+		}
+		close(allow)
+		qaAwait(t, done)
+		if owner.Close() != first || session.ends != 0 {
+			t.Fatal("late completion discarded terminal cleanup error")
+		}
+	})
+}
+
+func TestExVPNWindowsSessionConcurrentCloseAndRetiredIO(t *testing.T) {
+	for _, closeFailure := range []bool{false, true} {
+		events := newQAWindowsEvents()
+		if closeFailure {
+			events.closeErr = errors.New("close event failure")
+		}
+		session := &qaWindowsSession{}
+		owner := newWindowsTunSession(session, events)
+		var group sync.WaitGroup
+		for range 16 {
+			group.Add(1)
+			go func() {
+				defer group.Done()
+				if err := owner.Close(); err != events.closeErr {
+					t.Error("close result changed")
+				}
+			}()
+		}
+		group.Wait()
+		if session.ends != 1 || events.wakeCount != 1 || events.closeCount != 1 {
+			t.Fatal("cleanup did not run exactly once")
+		}
+		if _, _, err := owner.ReadPacket(); !errors.Is(err, os.ErrClosed) {
+			t.Fatal("retired read accepted")
+		}
+		packet := qaWindowsPacket()
+		if owner.WritePacket(packet) == nil {
+			t.Fatal("retired write accepted")
+		}
+		packet.DecRef()
+		owner.Wait()
+		if session.receives != 0 || session.allocations != 0 || events.waitCount != 0 {
+			t.Fatal("retired operation reached native API")
+		}
+	}
+}
