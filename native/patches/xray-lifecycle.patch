+func TestExVPNQAStartupFailureCancelsBeforeJoiningUDP(t *testing.T) {
+	for _, stage := range []string{"factory", "stack", "tun", "dns"} {
+		t.Run(stage, func(t *testing.T) {
+			handler, tun, dispatcher := qaStartupFixture(t)
+			sentinel := errors.New("startup_" + stage + "_sentinel")
+			tun.closeErr = errors.New("cleanup_sentinel")
+			activate := func() error {
+				if err := qaInjectStartupPacket(tun, dispatcher); err != nil {
+					return err
+				}
+				return sentinel
+			}
+			switch stage {
+			case "stack":
+				tun.endpointErr = sentinel
+			case "tun":
+				tun.start = activate
+			case "dns":
+				tun.dns = activate
+			}
+			factory := func(*Config) (Tun, error) {
+				if stage == "factory" {
+					return tun, sentinel
+				}
+				return tun, nil
+			}
+			result := make(chan error, 1)
+			go func() { result <- handler.start(factory) }()
+			select {
+			case err := <-result:
+				if err == nil || !strings.Contains(err.Error(), sentinel.Error()) || !strings.Contains(err.Error(), "cleanup_sentinel") {
+					t.Fatalf("startup/cleanup error lost: %v", err)
+				}
+			case <-time.After(2 * time.Second):
+				// Failure cleanup only: the product path must cancel itself first.
+				handler.cancel()
+				<-result
+				t.Fatal("startup error cleanup blocked on its own live worker")
+			}
+			if handler.ctx.Err() == nil || tun.closes.Load() != 1 {
+				t.Fatal("startup failure did not retire owned context and TUN once")
+			}
+			if stage == "tun" || stage == "dns" {
+				select {
+				case <-dispatcher.done:
+				default:
+					t.Fatal("startup failure returned before owned UDP worker completed")
+				}
+			}
+			for i := 0; i < 2; i++ {
+				if err := handler.Close(); err == nil || !strings.Contains(err.Error(), "cleanup_sentinel") {
+					t.Fatal("post-failure Close lost the cleanup error")
+				}
+			}
+			if tun.closes.Load() != 1 {
+				t.Fatal("post-failure Close reran cleanup")
+			}
+		})
+	}
+}
