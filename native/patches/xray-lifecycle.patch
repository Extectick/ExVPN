+func TestExVPNTrackedUDPPreservesOOBAndClosesActualSocket(t *testing.T) {
+	local, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	peer, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	resources := newClientResources()
+	defer resources.close(func() error { return nil })
+	tracked, err := resources.trackPacket(local)
+	if err != nil {
+		t.Fatal(err)
+	}
+	oob, ok := tracked.(quic.OOBCapablePacketConn)
+	if !ok {
+		t.Fatal("tracking hid the original UDP OOB capability")
+	}
+	raw, err := oob.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	called := false
+	if err := raw.Control(func(uintptr) { called = true }); err != nil || !called {
+		t.Fatal("tracked socket did not expose its live syscall handle")
+	}
+	if err := oob.SetReadBuffer(32768); err != nil {
+		t.Fatal(err)
+	}
+	writeBuffer, ok := tracked.(interface{ SetWriteBuffer(int) error })
+	if !ok || writeBuffer.SetWriteBuffer(32768) != nil {
+		t.Fatal("tracking hid the original UDP send-buffer capability")
+	}
+	tracked.SetDeadline(time.Now().Add(3 * time.Second))
+	peer.SetDeadline(time.Now().Add(3 * time.Second))
+	payload := []byte("synthetic-udp-lifecycle")
+	// Assert actual delivery below. The pinned Go Windows WSASendMsg path can
+	// report zero completion bytes even after delivering the whole datagram.
+	if _, _, err := oob.WriteMsgUDP(payload, nil, peer.LocalAddr().(*net.UDPAddr)); err != nil {
+		t.Fatal("tracked WriteMsgUDP failed")
+	}
+	buffer := make([]byte, 128)
+	n, _, _, source, err := peer.ReadMsgUDP(buffer, nil)
+	if err != nil || !bytes.Equal(buffer[:n], payload) || source.Port != local.LocalAddr().(*net.UDPAddr).Port {
+		t.Fatal("peer did not receive the tracked UDP datagram")
+	}
+	if _, _, err := peer.WriteMsgUDP(payload, nil, source); err != nil {
+		t.Fatal(err)
+	}
+	n, _, _, source, err = oob.ReadMsgUDP(buffer, nil)
+	if err != nil || !bytes.Equal(buffer[:n], payload) || source.Port != peer.LocalAddr().(*net.UDPAddr).Port {
+		t.Fatal("tracked ReadMsgUDP did not receive the peer datagram")
+	}
+	if err := resources.close(func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, _, err := oob.ReadMsgUDP(buffer, nil); !errors.Is(err, net.ErrClosed) {
+		t.Fatal("retirement left the underlying OOB reader open")
+	}
+	if _, _, err := oob.WriteMsgUDP(payload, nil, peer.LocalAddr().(*net.UDPAddr)); !errors.Is(err, net.ErrClosed) {
+		t.Fatal("retirement left the underlying OOB writer open")
+	}
+	resources.mu.Lock()
+	remaining := len(resources.owned)
+	resources.mu.Unlock()
+	if remaining != 0 {
+		t.Fatal("OOB wrapper did not relinquish its owned socket")
+	}
+}
