+func TestExVPNWindowsSessionConcurrentReadWriteClose(t *testing.T) {
+	for range 25 {
+		readEntered, writeEntered := make(chan struct{}), make(chan struct{})
+		var readOnce, writeOnce sync.Once
+		session := &qaWindowsSession{packet: []byte{0x45, 1, 2, 3},
+			receiveGate: func() { readOnce.Do(func() { close(readEntered) }) },
+			sendGate:    func() { writeOnce.Do(func() { close(writeEntered) }) },
+		}
+		events := newQAWindowsEvents()
+		events.waitEntered = make(chan struct{})
+		owner := newWindowsTunSession(session, events)
+		start := make(chan struct{})
+		var group sync.WaitGroup
+		for worker := range 8 {
+			group.Add(1)
+			go func() {
+				defer group.Done()
+				<-start
+				for range 64 {
+					if worker%2 == 0 {
+						_, packet, err := owner.ReadPacket()
+						if errors.Is(err, os.ErrClosed) {
+							return
+						}
+						if err != nil {
+							t.Error(err)
+							return
+						}
+						packet.DecRef()
+					} else {
+						packet := qaWindowsPacket()
+						err := owner.WritePacket(packet)
+						packet.DecRef()
+						if err != nil {
+							return
+						}
+					}
+				}
+			}()
+		}
+		group.Add(1)
+		go func() { defer group.Done(); owner.Wait() }()
+		close(start)
+		qaAwait(t, readEntered)
+		qaAwait(t, writeEntered)
+		qaAwait(t, events.waitEntered)
+		for range 8 {
+			group.Add(1)
+			go func() {
+				defer group.Done()
+				if err := owner.Close(); err != nil {
+					t.Error(err)
+				}
+			}()
+		}
+		group.Wait()
+		if session.ends != 1 || session.callAfterEnd || session.releaseAfterEnd || session.endWhileActive || session.releases != session.receives {
+			t.Fatal("concurrent native IO escaped its session lifetime")
+		}
+	}
+}
