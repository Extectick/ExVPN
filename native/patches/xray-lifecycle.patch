+func TestExVPNTransportLifetimeSharingAndLazyInitialization(t *testing.T) {
+	parent := new(MemoryStreamConfig)
+	owners := make(chan *TransportLifetime, 32)
+	var workers sync.WaitGroup
+	for i := 0; i < cap(owners); i++ {
+		workers.Add(1)
+		go func() { defer workers.Done(); owners <- parent.Lifecycle() }()
+	}
+	workers.Wait()
+	close(owners)
+	for owner := range owners {
+		if owner != parent.Lifecycle() {
+			t.Fatal("one config acquired multiple lifetimes")
+		}
+	}
+	child := new(MemoryStreamConfig)
+	if err := child.ShareTransportLifetime(parent); err != nil || child.Lifecycle() != parent.Lifecycle() {
+		t.Fatal("download config did not share owner", err)
+	}
+	copyOfParent := *parent // no copied mutex or Once; a stable owner pointer.
+	if copyOfParent.Lifecycle() != parent.Lifecycle() {
+		t.Fatal("parsed config copy lost its initialized owner")
+	}
+	if err := parent.Close(); err != nil || !child.Lifecycle().IsClosed() || !copyOfParent.Lifecycle().IsClosed() {
+		t.Fatal("derived configs survived parent retirement", err)
+	}
+	if err := child.ShareTransportLifetime(new(MemoryStreamConfig)); err == nil {
+		t.Fatal("retired owner was replaced")
+	}
+	lateChild := new(MemoryStreamConfig)
+	if err := lateChild.ShareTransportLifetime(parent); err != nil || !lateChild.Lifecycle().IsClosed() {
+		t.Fatal("late derived config resurrected retired parent", err)
+	}
+	if err := parent.Lifecycle().Register(nil); err == nil {
+		t.Fatal("nil closer accepted")
+	}
+	var missing *MemoryStreamConfig
+	if err := missing.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := child.ShareTransportLifetime(nil); err == nil {
+		t.Fatal("missing parent accepted")
+	}
+}
