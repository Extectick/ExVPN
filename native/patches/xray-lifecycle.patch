+func lifetimeRealityConfig(t *testing.T) *internet.MemoryStreamConfig {
+	t.Helper()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	settings := lifetimeConfig(false)
+	settings.SecurityType = "reality"
+	settings.SecuritySettings = &reality.Config{
