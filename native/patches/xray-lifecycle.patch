+	first := tun.Close()
+	if !errors.Is(first, fault) || tun.Close() != first {
+		t.Fatal("WindowsTun lost the stable cleanup failure")
+	}
+	if session.ends != 0 || events.closeCount != 0 {
+		t.Fatal("WindowsTun freed handles after a failed retirement")
+	}
+}
+
+func TestExVPNWindowsSessionIndependentOwnerAndWaitFailure(t *testing.T) {
+	first := newWindowsTunSession(&qaWindowsSession{}, newQAWindowsEvents())
+	live := newWindowsTunSession(&qaWindowsSession{packet: []byte{0x45, 1}}, newQAWindowsEvents())
+	if err := first.Close(); err != nil {
+		t.Fatal(err)
+	}
+	_, packet, err := live.ReadPacket()
+	if err != nil {
+		t.Fatal("independent owner retired")
