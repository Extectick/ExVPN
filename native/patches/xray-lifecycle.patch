+func TestExVPNCloseCancelsRawH1AndIdlePool(t *testing.T) {
+	for _, stalled := range []bool{false, true} {
+		t.Run(strconv.FormatBool(stalled), func(t *testing.T) {
+			entered := make(chan struct{})
+			var once sync.Once
+			dest, settings, url := exVPNHTTPFixture(t, "1.1", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				io.Copy(io.Discard, r.Body)
+				once.Do(func() { close(entered) })
+				if stalled {
+					<-r.Context().Done()
+					return
+				}
+				w.WriteHeader(http.StatusOK)
+			}))
+			t.Cleanup(func() { settings.Close() })
+			client, _, err := getHTTPClient(context.Background(), dest, settings)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := client.PostPacket(context.Background(), url, "session", "0", exVPNPayload()); err != nil {
+				t.Fatal(err)
+			}
+			waitExVPN(t, entered, "server did not receive raw upload")
+			runtime := client.(*DefaultDialerClient).resources
+			runtime.mu.Lock()
+			idle, owned := len(runtime.idleH1), len(runtime.owned)
+			runtime.mu.Unlock()
+			if idle != 1 || owned != 1 {
+				t.Fatal("raw upload not owned while pooled")
+			}
+			var secondDone chan struct{}
+			var secondErr error
+			if stalled {
+				secondDone = make(chan struct{})
+				go func() {
+					secondErr = client.PostPacket(context.Background(), url, "session", "1", exVPNPayload())
+					close(secondDone)
+				}()
+			}
+			closeExVPN(t, settings)
+			if stalled {
+				waitExVPN(t, secondDone, "raw response read survived retirement")
+				if secondErr == nil {
+					t.Fatal("retired raw upload succeeded")
+				}
+			}
+			runtime.mu.Lock()
+			idle, owned = len(runtime.idleH1), len(runtime.owned)
+			runtime.mu.Unlock()
+			if idle != 0 || owned != 0 {
+				t.Fatal("raw pool survived owner close")
+			}
+			if err := client.PostPacket(context.Background(), url, "session", "2", exVPNPayload()); !errors.Is(err, internet.ErrTransportClosed) {
+				t.Fatal("retired client reused an upload socket")
+			}
+		})
+	}
+}
