+package tun
+
+import (
+	"context"
+	"errors"
+	"io"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+func TestExVPNQAHandlerOwnsOnlyItsContext(t *testing.T) {
+	parent, cancelParent := context.WithCancel(context.Background())
+	defer cancelParent()
+	instance, err := core.NewWithContext(parent, &core.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer instance.Close()
+	if err := instance.AddFeature(&qaDNSDispatcher{}); err != nil {
+		t.Fatal(err)
+	}
+	first, err := core.CreateObject(instance, &Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := core.CreateObject(instance, &Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, b := first.(*Handler), second.(*Handler)
+	defer b.Close()
+	if err := a.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(a.ctx.Err(), context.Canceled) {
+		t.Fatal("closed handler's context remains alive")
+	}
+	if parent.Err() != nil || b.ctx.Err() != nil {
+		t.Fatal("closing one handler cancelled a foreign owner")
+	}
+}
+
+type qaClosingStack struct {
+	entered chan struct{}
+	release chan struct{}
+	calls   atomic.Int32
+	err     error
+}
+
+func (*qaClosingStack) Start() error { return nil }
+func (s *qaClosingStack) Close() error {
+	s.calls.Add(1)
+	close(s.entered)
+	<-s.release
+	return s.err
+}
+
+type qaClosingTun struct {
+	calls atomic.Int32
+	err   error
+}
+
+func (*qaClosingTun) Start() error          { return nil }
+func (*qaClosingTun) Name() (string, error) { return "memory-only", nil }
+func (*qaClosingTun) Index() (int, error)   { return 1, nil }
+func (*qaClosingTun) newEndpoint() (stack.LinkEndpoint, error) {
+	return nil, errors.New("must not start")
+}
+func (t *qaClosingTun) Close() error { t.calls.Add(1); return t.err }
+
+func TestExVPNQAConcurrentCloseRetainsCleanupErrors(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	stack := &qaClosingStack{entered: make(chan struct{}), release: make(chan struct{}), err: errors.New("stack_close_sentinel")}
+	tun := &qaClosingTun{err: errors.New("tun_close_sentinel")}
+	handler := &Handler{ctx: ctx, cancel: cancel, stack: stack, tun: tun}
+	results := make(chan error, 8)
+	go func() { results <- handler.Close() }()
+	select {
+	case <-stack.entered:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not enter stack cleanup")
+	}
+	if ctx.Err() == nil {
+		close(stack.release)
+		t.Fatal("owned context was not cancelled before stack cleanup")
+	}
+	for i := 0; i < 7; i++ {
+		go func() { results <- handler.Close() }()
+	}
+	select {
+	case <-results:
+		close(stack.release)
+		t.Fatal("Close returned before cleanup completed")
+	default:
+	}
+	close(stack.release)
+	for i := 0; i < 8; i++ {
+		select {
+		case err := <-results:
+			if err == nil || !strings.Contains(err.Error(), "stack_close_sentinel") || !strings.Contains(err.Error(), "tun_close_sentinel") {
+				t.Fatalf("cleanup error lost: %v", err)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("concurrent Close did not complete")
+		}
+	}
+	if stack.calls.Load() != 1 || tun.calls.Load() != 1 {
+		t.Fatal("cleanup ran more than once")
+	}
+}
+
+func TestExVPNQAUDPRetirementWaitsAndRejectsLatePackets(t *testing.T) {
+	firstRead := make(chan struct{})
+	release := make(chan struct{})
+	workerDone := make(chan struct{})
+	readErr := make(chan error, 1)
+	var calls atomic.Int32
+	u := newUdpConnectionHandler(func(conn xnet.Conn, _ xnet.Destination) {
+		calls.Add(1)
+		defer close(workerDone)
+		defer conn.Close()
+		mb, err := conn.(*udpConn).ReadMultiBuffer()
+		buf.ReleaseMulti(mb)
+		if err != nil {
+			readErr <- err
+			return
+		}
+		close(firstRead)
+		<-release
+		mb, err = conn.(*udpConn).ReadMultiBuffer()
+		buf.ReleaseMulti(mb)
+		readErr <- err
+	}, func([]byte, xnet.Destination, xnet.Destination) error { return nil })
+	src := xnet.UDPDestination(xnet.IPAddress([]byte{198, 18, 0, 1}), 41001)
+	dst := xnet.UDPDestination(xnet.IPAddress([]byte{198, 18, 0, 2}), 53)
+	u.HandlePacket(src, dst, []byte("synthetic"))
+	select {
+	case <-firstRead:
+	case <-time.After(time.Second):
+		t.Fatal("worker never received packet")
+	}
+	closes := make(chan struct{}, 2)
+	go func() { u.Close(); closes <- struct{}{} }()
+	deadline := time.Now().Add(time.Second)
+	for {
+		u.RLock()
+		closed := u.closed
+		u.RUnlock()
+		if closed {
+			break
+		}
+		if time.Now().After(deadline) {
+			close(release)
+			t.Fatal("UDP owner did not retire")
+		}
+		runtime.Gosched()
+	}
+	go func() { u.Close(); closes <- struct{}{} }()
+	var senders sync.WaitGroup
+	for i := 0; i < 24; i++ {
+		senders.Add(1)
+		go func(i int) {
+			defer senders.Done()
+			source := src
+			source.Port += xnet.Port(i)
+			u.HandlePacket(source, dst, []byte("late"))
+		}(i)
+	}
+	senders.Wait()
+	select {
+	case <-closes:
+		close(release)
+		t.Fatal("Close returned while owned worker was still active")
+	default:
+	}
+	close(release)
+	for i := 0; i < 2; i++ {
+		select {
+		case <-closes:
+		case <-time.After(time.Second):
+			t.Fatal("Close did not join worker")
+		}
+	}
+	select {
+	case <-workerDone:
+	default:
+		t.Fatal("worker was not joined")
+	}
+	if err := <-readErr; !errors.Is(err, io.EOF) {
+		t.Fatalf("retired reader did not receive EOF: %v", err)
+	}
+	if calls.Load() != 1 {
+		t.Fatal("late packet resurrected a UDP worker")
+	}
+	u.RLock()
+	remaining := len(u.udpConns)
+	u.RUnlock()
+	if remaining != 0 {
+		t.Fatal("closed UDP owner retained a connection")
+	}
+}
+
+func TestExVPNQAClosingOneActiveDNSHandlerKeepsAnother(t *testing.T) {
+	first, firstDispatcher, _ := qaDNSFixture(t)
+	second, secondDispatcher, _ := qaDNSFixture(t)
+	if err := first.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-firstDispatcher.done:
+	default:
+		t.Fatal("closed DNS worker remains alive")
+	}
+	select {
+	case <-secondDispatcher.done:
+		t.Fatal("closing one inbound stopped another")
+	default:
+	}
+	if second.ctx.Err() != nil {
+		t.Fatal("independent context cancelled")
+	}
+	if err := second.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-secondDispatcher.done:
+	default:
+		t.Fatal("second DNS worker remains alive")
+	}
+}
