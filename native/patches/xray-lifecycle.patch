+package tun
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+type qaStartupDispatcher struct {
+	entered chan struct{}
+	done    chan struct{}
+}
+
+func (*qaStartupDispatcher) Type() interface{} { return routing.DispatcherType() }
+func (*qaStartupDispatcher) Start() error      { return nil }
+func (*qaStartupDispatcher) Close() error      { return nil }
+func (*qaStartupDispatcher) Dispatch(context.Context, xnet.Destination) (*transport.Link, error) {
+	return nil, errors.New("unexpected Dispatch")
+}
+func (d *qaStartupDispatcher) DispatchLink(ctx context.Context, _ xnet.Destination, link *transport.Link) error {
+	defer close(d.done)
+	mb, err := link.Reader.ReadMultiBuffer()
+	buf.ReleaseMulti(mb)
+	if err != nil {
+		return err
+	}
+	close(d.entered)
+	<-ctx.Done()
+	return ctx.Err()
+}
+
+type qaStartupTun struct {
+	qaMemoryTun
+	endpointErr error
+	start       func() error
+	dns         func() error
+	closeErr    error
