+func exVPNQUICClientHello(t *testing.T) []byte {
+	t.Helper()
+	client := stdtls.QUICClient(&stdtls.QUICConfig{TLSConfig: &stdtls.Config{
+		ServerName: "public.example", MinVersion: stdtls.VersionTLS13,
+	}})
+	defer client.Close()
+	client.SetTransportParameters([]byte{})
+	if err := client.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	for {
+		event := client.NextEvent()
+		if event.Kind == stdtls.QUICNoEvent {
+			t.Fatal("missing QUIC TLS Initial ClientHello")
+		}
+		if event.Kind == stdtls.QUICWriteData && event.Level == stdtls.QUICEncryptionLevelInitial {
+			return append([]byte(nil), event.Data...)
+		}
+	}
+}
+
+func exVPNQUICMutateHello(t *testing.T, hello []byte, mode string) []byte {
+	t.Helper()
+	position := 39 + int(hello[38])
+	position += 2 + int(binary.BigEndian.Uint16(hello[position:]))
+	position += 1 + int(hello[position])
+	extensions := append([]byte(nil), hello[position+2:]...)
+	// Opaque ECH/GREASE bytes suffice: without ECH decryption the public name
+	// is never a trusted destination. This is not a successful ECH handshake.
+	ech := []byte{0xfe, 0x0d, 0, 3, 0xa1, 0xb2, 0xc3}
+	switch mode {
+	case "ech_before_sni":
+		extensions = append(append([]byte(nil), ech...), extensions...)
+	case "ech_after_sni":
+		extensions = append(extensions, ech...)
+	case "malformed_after_sni":
+		extensions = append(extensions, 0, 17, 0, 5, 1)
+	case "duplicate_sni":
+		for remaining := extensions; len(remaining) >= 4; {
+			length := 4 + int(binary.BigEndian.Uint16(remaining[2:4]))
+			if length > len(remaining) {
+				t.Fatal("invalid generated extension")
+			}
+			if binary.BigEndian.Uint16(remaining[:2]) == 0 {
+				extensions = append(extensions, remaining[:length]...)
+				break
+			}
+			remaining = remaining[length:]
+		}
+	}
+	result := append([]byte(nil), hello[:position]...)
+	result = binary.BigEndian.AppendUint16(result, uint16(len(extensions)))
+	result = append(result, extensions...)
+	length := len(result) - 4
+	result[1], result[2], result[3] = byte(length>>16), byte(length>>8), byte(length)
+	return result
+}
+
+func exVPNQUICInitial(t *testing.T, hello []byte) []byte {
+	t.Helper()
+	dcid := []byte{0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08}
+	frames := quicvarint.Append([]byte{6, 0}, uint64(len(hello)))
+	frames = append(frames, hello...)
+	if len(frames) < 1200 {
+		frames = append(frames, make([]byte, 1200-len(frames))...)
+	}
+	header := binary.BigEndian.AppendUint32([]byte{0xc3}, quicV1.ver)
+	header = append(header, byte(len(dcid)))
+	header = append(header, dcid...)
+	header = append(header, 0, 0) // empty source CID and token
+	header = quicvarint.Append(header, uint64(4+len(frames)+16))
+	packetNumberOffset := len(header)
+	header = append(header, 0, 0, 0, 1)
+	initialSecret := hkdf.Extract(crypto.SHA256.New, dcid, quicV1.initialSalt)
+	secret := hkdfExpandLabel(initialSecret, "client in", crypto.SHA256.Size())
+	key := hkdfExpandLabel(secret, "quic key", 16)
+	iv := hkdfExpandLabel(secret, "quic iv", 12)
+	aead := AEADAESGCMTLS13(key, iv)
+	nonce := make([]byte, aead.NonceSize())
+	nonce[len(nonce)-1] = 1
+	packet := append(header, aead.Seal(nil, nonce, frames, header)...)
+	hp, err := aes.NewCipher(hkdfExpandLabel(secret, "quic hp", 16))
+	if err != nil {
+		t.Fatal(err)
+	}
+	mask := make([]byte, hp.BlockSize())
+	hp.Encrypt(mask, packet[packetNumberOffset+4:packetNumberOffset+4+len(mask)])
+	packet[0] ^= mask[0] & 0xf
+	for index := 0; index < 4; index++ {
+		packet[packetNumberOffset+index] ^= mask[index+1]
+	}
+	return packet
+}
+
+func TestExVPNQUICClientHelloTrustedDomain(t *testing.T) {
+	hello := exVPNQUICClientHello(t)
+	for _, mode := range []string{"ordinary_sni", "ech_before_sni", "ech_after_sni", "malformed_after_sni", "duplicate_sni"} {
+		t.Run(mode, func(t *testing.T) {
+			packet := exVPNQUICInitial(t, exVPNQUICMutateHello(t, hello, mode))
+			header, err := SniffQUIC(packet)
+			if mode == "ordinary_sni" {
+				if err != nil || header == nil || header.Domain() != "public.example" {
+					t.Fatalf("ordinary encrypted QUIC Initial: header=%v err=%v", header, err)
+				}
+			} else if err == nil || header != nil {
+				t.Fatalf("QUIC trusted ambiguous ClientHello: header=%v err=%v", header, err)
+			}
+		})
+	}
+}
