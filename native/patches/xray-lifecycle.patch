+	if err := lifetime.Register(func() error {
+		calls.Add(1)
+		if !lifetime.IsClosed() || !errors.Is(lifetime.Context().Err(), context.Canceled) {
+			t.Error("cleanup ran before owner retirement/cancellation")
+		}
+		close(entered)
+		<-release
+		return want
+	}); err != nil {
+		t.Fatal(err)
+	}
+	first := make(chan error, 1)
+	go func() { first <- settings.Close() }()
+	<-entered
+	second := make(chan error, 1)
+	go func() { second <- settings.Close() }()
+	select {
+	case <-second:
+		t.Fatal("concurrent Close returned before owned cleanup finished")
+	case <-time.After(20 * time.Millisecond):
+	}
+	lateCalled := false
+	if err := lifetime.Register(func() error { lateCalled = true; return nil }); !errors.Is(err, ErrTransportClosed) || lateCalled {
+		t.Fatal("late registration was accepted or executed synchronously")
+	}
+	close(release)
+	if !errors.Is(<-first, want) || !errors.Is(<-second, want) || !errors.Is(settings.Close(), want) || calls.Load() != 1 {
+		t.Fatal("Close did not preserve the one completed cleanup result")
+	}
+}
