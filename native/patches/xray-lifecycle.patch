+			t.Run(network+"/"+strconv.FormatBool(closeFails), func(t *testing.T) {
+				var closeError error
+				if closeFails {
+					closeError = errors.New("synthetic partial-dial close failure")
+				}
+				dialError := errors.New("synthetic partial dial failure")
+				var partial net.Conn
