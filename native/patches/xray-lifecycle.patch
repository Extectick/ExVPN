+func TestExVPNWindowsSessionQueueAndInvalidData(t *testing.T) {
+	for _, err := range []error{windows.ERROR_NO_MORE_ITEMS, nil, windows.ERROR_HANDLE_EOF} {
+		session := &qaWindowsSession{receiveErr: err}
