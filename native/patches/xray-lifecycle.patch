diff --git a/transport/internet/transport_lifetime.go b/transport/internet/transport_lifetime.go
new file mode 100644
index 0000000000000000000000000000000000000000..8e67c4f80385080d480ffa6cb3498ffc5142ad9f
--- /dev/null
+++ b/transport/internet/transport_lifetime.go
@@ -0,0 +1,120 @@
+// ExVPN modifications, Copyright 2026 ExVPN contributors.
+// SPDX-License-Identifier: MPL-2.0
+
+package internet
+
+import (
+	"context"
+	"errors"
+	"sync"
+)
+
+// ErrTransportClosed rejects new resources belonging to a retired stream owner.
+var ErrTransportClosed = errors.New("transport owner is closed")
+
+// Protects only lazy owner pointer initialization; it does not retain configs.
+// A MemoryStreamConfig must not be copied concurrently with its first use.
+var memoryStreamLifetimeAccess sync.Mutex
+
+// Lifecycle returns the stable lifetime of this parsed stream configuration.
+// Configurations derived before publication can share this pointer explicitly.
+func (s *MemoryStreamConfig) Lifecycle() *TransportLifetime {
+	memoryStreamLifetimeAccess.Lock()
+	defer memoryStreamLifetimeAccess.Unlock()
+	if s.transportLifetime == nil {
+		ctx, cancel := context.WithCancel(context.Background())
+		s.transportLifetime = &TransportLifetime{ctx: ctx, cancel: cancel, done: make(chan struct{})}
+	}
+	return s.transportLifetime
+}
+
+// ShareTransportLifetime attaches an unused derived config to its parent's
+// owner. Call before publishing the child. A previously used owner cannot be
+// replaced or resurrected, including when that owner has already closed.
+func (s *MemoryStreamConfig) ShareTransportLifetime(parent *MemoryStreamConfig) error {
+	if s == nil || parent == nil {
+		return errors.New("transport owner is missing")
+	}
+	owner := parent.Lifecycle()
+	memoryStreamLifetimeAccess.Lock()
+	defer memoryStreamLifetimeAccess.Unlock()
+	if s.transportLifetime != nil && s.transportLifetime != owner {
+		return errors.New("transport owner is already initialized")
+	}
+	s.transportLifetime = owner
+	return nil
+}
+
+// Close retires this config and every derived config sharing its lifetime.
+func (s *MemoryStreamConfig) Close() error {
+	if s == nil {
+		return nil
+	}
+	return s.Lifecycle().Close()
+}
+
+// TransportLifetime owns transport caches and their background work. A cache
+// may hold its mutex while calling Register or IsClosed. Close never invokes
+// callbacks under this lifetime's mutex, so callbacks may acquire cache locks.
+// The zero value is not usable; obtain an instance through Lifecycle.
+type TransportLifetime struct {
+	mu      sync.Mutex
+	ctx     context.Context
+	cancel  context.CancelFunc
+	closed  bool
+	closers []func() error
+	done    chan struct{}
+	err     error
+}
+
+// Context is canceled as soon as retirement begins, before resource closers.
+func (l *TransportLifetime) Context() context.Context { return l.ctx }
+
+func (l *TransportLifetime) IsClosed() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.closed
+}
+
+// Register transfers a closer to this owner. On rejection the caller retains
+// responsibility for cleanup; the callback is never invoked synchronously.
+// A callback must not recursively Close its own lifetime or wait for that Close.
+func (l *TransportLifetime) Register(closer func() error) error {
+	if closer == nil {
+		return errors.New("transport closer is missing")
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.closed {
+		return ErrTransportClosed
+	}
+	l.closers = append(l.closers, closer)
+	return nil
+}
+
+// Close is idempotent and joins all registered closers. Concurrent callers wait
+// for the same cleanup and receive its stable error. Registration is forbidden
+// from the moment closed is set, so delayed dials cannot revive this owner.
+func (l *TransportLifetime) Close() error {
+	l.mu.Lock()
+	if l.closed {
+		done := l.done
+		l.mu.Unlock()
+		<-done
+		return l.err
+	}
+	l.closed = true
+	closers := l.closers
+	l.closers = nil
+	l.mu.Unlock()
+	l.cancel()
+	var errs []error
+	for _, closer := range closers {
+		if err := closer(); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	l.err = errors.Join(errs...)
+	close(l.done)
+	return l.err
+}
