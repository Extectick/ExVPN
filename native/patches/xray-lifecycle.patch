@@ -0,0 +1,522 @@
+// ExVPN modifications, Copyright 2026 ExVPN contributors.
+// SPDX-License-Identifier: MPL-2.0
+
+package grpc
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/binary"
+	"errors"
+	"io"
+	gonet "net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/grpc/encoding"
+	"github.com/xtls/xray-core/transport/internet/reality"
+	gogrpc "google.golang.org/grpc"
+	"google.golang.org/grpc/connectivity"
+	"google.golang.org/grpc/stats"
+)
+
+type lifetimeEchoServer struct {
+	encoding.UnimplementedGRPCServiceServer
+}
+
+func (*lifetimeEchoServer) Tun(stream encoding.GRPCService_TunServer) error {
+	for {
+		message, err := stream.Recv()
+		if err != nil {
+			return err
+		}
+		if err := stream.Send(message); err != nil {
+			return err
+		}
+	}
+}
+
+func (*lifetimeEchoServer) TunMulti(stream encoding.GRPCService_TunMultiServer) error {
+	for {
+		message, err := stream.Recv()
+		if err != nil {
+			return err
+		}
+		if err := stream.Send(message); err != nil {
+			return err
+		}
+	}
+}
+
+type lifetimeStats struct{ active atomic.Int32 }
+
+func (*lifetimeStats) TagRPC(ctx context.Context, _ *stats.RPCTagInfo) context.Context   { return ctx }
+func (*lifetimeStats) HandleRPC(context.Context, stats.RPCStats)                         {}
+func (*lifetimeStats) TagConn(ctx context.Context, _ *stats.ConnTagInfo) context.Context { return ctx }
+func (s *lifetimeStats) HandleConn(_ context.Context, event stats.ConnStats) {
+	switch event.(type) {
+	case *stats.ConnBegin:
+		s.active.Add(1)
+	case *stats.ConnEnd:
+		s.active.Add(-1)
+	}
+}
+
+func lifetimeConfig(multi bool) *internet.MemoryStreamConfig {
+	return &internet.MemoryStreamConfig{ProtocolName: "grpc", ProtocolSettings: &Config{ServiceName: "exvpn-lifetime", UserAgent: "golang", MultiMode: multi}}
+}
+
+func startLifetimeEcho(t *testing.T) (net.Destination, *lifetimeStats) {
+	t.Helper()
+	listener, err := gonet.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	counts := new(lifetimeStats)
+	server := gogrpc.NewServer(gogrpc.StatsHandler(counts))
+	encoding.RegisterGRPCServiceServerX(server, &lifetimeEchoServer{}, "exvpn-lifetime", "Tun", "TunMulti")
+	finished := make(chan struct{})
+	go func() { defer close(finished); _ = server.Serve(listener) }()
+	t.Cleanup(func() { server.Stop(); listener.Close(); <-finished })
+	return net.TCPDestination(net.LocalHostIP, net.Port(listener.Addr().(*gonet.TCPAddr).Port)), counts
+}
+
+func waitLifetime(t *testing.T, message string, check func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for !check() {
+		if time.Now().After(deadline) {
+			t.Fatal(message)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+func assertLifetimeEcho(t *testing.T, conn net.Conn) {
+	t.Helper()
+	finished := make(chan error, 1)
+	go func() {
+		payload := []byte("synthetic owner payload")
+		if _, err := conn.Write(payload); err != nil {
+			finished <- err
+			return
+		}
+		got := make([]byte, len(payload))
+		if _, err := io.ReadFull(conn, got); err != nil {
+			finished <- err
+			return
+		}
+		if string(got) != string(payload) {
+			finished <- errors.New("echo differed")
+			return
+		}
+		finished <- nil
+	}()
+	select {
+	case err := <-finished:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(3 * time.Second):
+		conn.Close()
+		t.Fatal("loopback gRPC payload timed out")
+	}
+}
+
+func grpcOwnerPresent(settings *internet.MemoryStreamConfig) bool {
+	globalDialerAccess.Lock()
+	defer globalDialerAccess.Unlock()
+	if _, found := globalDialerOwners[settings]; found {
+		return true
+	}
+	for key := range globalDialerMap {
+		if key.MemoryStreamConfig == settings {
+			return true
+		}
+	}
+	return false
+}
+
+func TestExVPNGRPCLifetimeClosesActiveOwnerKeepsIndependentOwner(t *testing.T) {
+	for _, multi := range []bool{false, true} {
+		t.Run(map[bool]string{false: "gun", true: "multi"}[multi], func(t *testing.T) {
+			dest, counts := startLifetimeEcho(t)
+			first, second := lifetimeConfig(multi), lifetimeConfig(multi)
+			t.Cleanup(func() { first.Close(); second.Close() })
+			ctx, cancel := context.WithTimeout(context.Background(), 6*time.Second)
+			defer cancel()
+			client1, err := getGrpcClient(ctx, dest, first)
+			if err != nil {
+				t.Fatal(err)
+			}
+			client2, err := getGrpcClient(ctx, dest, second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			waitLifetime(t, "both independent clients did not become ready", func() bool {
+				return client1.GetState() == connectivity.Ready && client2.GetState() == connectivity.Ready
+			})
+			conn1, err := Dial(ctx, dest, first)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn1.Close()
+			conn2, err := Dial(ctx, dest, second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn2.Close()
+			assertLifetimeEcho(t, conn1)
+			assertLifetimeEcho(t, conn2)
+			if err := first.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if client1.GetState() != connectivity.Shutdown || grpcOwnerPresent(first) {
+				t.Fatal("retired client or cache owner remains")
+			}
+			waitLifetime(t, "retired TCP connection remained active on peer", func() bool { return counts.active.Load() == 1 })
+			if _, err := getGrpcClient(ctx, dest, first); !errors.Is(err, internet.ErrTransportClosed) {
+				t.Fatal("retired config recreated a client", err)
+			}
+			assertLifetimeEcho(t, conn2)
+			again, err := getGrpcClient(ctx, dest, second)
+			if err != nil || again != client2 {
+				t.Fatal("independent owner was evicted", err)
+			}
+			if err := first.Close(); err != nil {
+				t.Fatal("repeat Close changed outcome", err)
+			}
+			if err := second.Close(); err != nil {
+				t.Fatal(err)
+			}
+			waitLifetime(t, "active sockets survived both owners", func() bool { return counts.active.Load() == 0 })
+		})
+	}
+}
+
+func TestExVPNGRPCLifetimeStopsBackgroundReconnects(t *testing.T) {
+	listener, err := gonet.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var attempts atomic.Int32
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			attempts.Add(1)
+			conn.Close()
+		}
+	}()
+	t.Cleanup(func() { listener.Close(); <-finished })
+	settings := lifetimeConfig(false)
+	t.Cleanup(func() { settings.Close() })
+	dest := net.TCPDestination(net.LocalHostIP, net.Port(listener.Addr().(*gonet.TCPAddr).Port))
+	client, err := getGrpcClient(context.Background(), dest, settings)
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitLifetime(t, "fixture did not observe a background gRPC retry", func() bool { return attempts.Load() >= 2 })
+	if err := settings.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if client.GetState() != connectivity.Shutdown || grpcOwnerPresent(settings) {
+		t.Fatal("background owner remained after Close")
+	}
+	// Longer than the next 750ms base backoff, including its 20% jitter.
+	time.Sleep(100 * time.Millisecond)
+	closedAttempts := attempts.Load()
+	time.Sleep(1100 * time.Millisecond)
+	if attempts.Load() != closedAttempts {
+		t.Fatalf("retired gRPC continued reconnecting: %d -> %d", closedAttempts, attempts.Load())
+	}
+}
+
+func TestExVPNGRPCLifetimeConcurrentDialCloseNoCacheResurrection(t *testing.T) {
+	dest, counts := startLifetimeEcho(t)
+	globalDialerAccess.Lock()
+	baselineClients, baselineOwners := len(globalDialerMap), len(globalDialerOwners)
+	globalDialerAccess.Unlock()
+	for cycle := 0; cycle < 24; cycle++ {
+		settings := lifetimeConfig(false)
+		start := make(chan struct{})
+		var workers sync.WaitGroup
+		for i := 0; i < 16; i++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				<-start
+				ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+				defer cancel()
+				conn, err := Dial(ctx, dest, settings)
+				if err == nil {
+					conn.Close()
+				}
+			}()
+		}
+		workers.Add(1)
+		go func() { defer workers.Done(); <-start; _ = settings.Close() }()
+		close(start)
+		workers.Wait()
+		if err := settings.Close(); err != nil || grpcOwnerPresent(settings) {
+			t.Fatal("retired owner remained after concurrent publication", err)
+		}
+		if _, err := getGrpcClient(context.Background(), dest, settings); !errors.Is(err, internet.ErrTransportClosed) {
+			t.Fatal("late dial resurrected retired owner", err)
+		}
+	}
+	waitLifetime(t, "concurrent dial sockets remained active", func() bool { return counts.active.Load() == 0 })
+	globalDialerAccess.Lock()
+	defer globalDialerAccess.Unlock()
+	if len(globalDialerMap) != baselineClients || len(globalDialerOwners) != baselineOwners {
+		t.Fatal("cache cardinality grew across retired owners")
+	}
+}
