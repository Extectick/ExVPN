+	settings := lifetimeConfig(false)
+	var release sync.Once
+	internet.UseAlternativeSystemDialer(dialer)
+	t.Cleanup(func() {
+		release.Do(func() { close(dialer.release) })
+		settings.Close()
+		peer.Close()
+		internet.UseAlternativeSystemDialer(nil)
