+func TestExVPNDownloadSettingsShareOwnerWithoutInitializationRaces(t *testing.T) {
+	dest := exVPNEchoFixture(t)
+	download := &internet.StreamConfig{Address: xnet.NewIPOrDomain(dest.Address), Port: uint32(dest.Port), ProtocolName: "splithttp", TransportSettings: []*internet.TransportConfig{{ProtocolName: "splithttp", Settings: serial.ToTypedMessage(&Config{Path: "/fixture"})}}}
+	config := &Config{Path: "/fixture", DownloadSettings: download}
+	parent := &internet.MemoryStreamConfig{ProtocolName: "splithttp", ProtocolSettings: config}
+	t.Cleanup(func() { parent.Close() })
+	children := make(chan *internet.MemoryStreamConfig, 32)
+	var group sync.WaitGroup
+	for range 32 {
+		group.Add(1)
+		go func() { defer group.Done(); child, _ := getDownloadSettings(parent, config); children <- child }()
+	}
+	group.Wait()
+	close(children)
+	var first *internet.MemoryStreamConfig
+	for child := range children {
+		if child == nil || child.Lifecycle() != parent.Lifecycle() {
+			t.Fatal("derived download owner diverged")
+		}
+		if first == nil {
+			first = child
+		}
+		if child != first {
+			t.Fatal("download config was published twice")
+		}
+	}
+	conn, err := Dial(context.Background(), dest, parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	exVPNExchange(t, conn)
+	closeExVPN(t, parent)
+	conn.Close()
+	if _, _, err = getHTTPClient(context.Background(), dest, first); !errors.Is(err, internet.ErrTransportClosed) {
+		t.Fatal("download cache resurrected retired parent")
+	}
+	globalDialerAccess.Lock()
+	defer globalDialerAccess.Unlock()
+	for key := range globalDialerMap {
+		if key.MemoryStreamConfig == parent || key.MemoryStreamConfig == first {
+			t.Fatal("main/download entry survived owner close")
+		}
+	}
