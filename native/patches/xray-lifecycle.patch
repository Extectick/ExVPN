+func TestExVPNConcurrentDialCloseCannotResurrectOwner(t *testing.T) {
+	entered := make(chan struct{}, 160)
+	dest, template, _ := exVPNHTTPFixture(t, "1.1", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		w.(http.Flusher).Flush()
+		entered <- struct{}{}
+		<-r.Context().Done()
+	}))
+	for range 20 {
+		for len(entered) > 0 {
+			<-entered
+		}
+		settings := &internet.MemoryStreamConfig{ProtocolName: "splithttp", ProtocolSettings: template.ProtocolSettings}
+		start, release, joined := make(chan struct{}), make(chan struct{}), make(chan struct{})
+		var group sync.WaitGroup
+		for range 8 {
+			group.Add(1)
+			go func() {
+				defer group.Done()
+				<-start
+				conn, _ := Dial(context.Background(), dest, settings)
+				if conn != nil {
+					<-release
+					conn.Close()
+				}
+			}()
+		}
+		close(start)
+		waitExVPN(t, entered, "no HTTP request raced with Close")
+		closeExVPN(t, settings)
+		close(release)
+		go func() { group.Wait(); close(joined) }()
+		waitExVPN(t, joined, "concurrent Dial did not finish after Close")
+		globalDialerAccess.Lock()
+		for key := range globalDialerMap {
+			if key.MemoryStreamConfig == settings {
+				globalDialerAccess.Unlock()
+				t.Fatal("concurrent cache publication resurrected a retired owner")
+			}
+		}
+		globalDialerAccess.Unlock()
+	}
+}
