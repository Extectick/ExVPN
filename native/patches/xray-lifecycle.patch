diff --git a/transport/internet/splithttp/lifecycle.go b/transport/internet/splithttp/lifecycle.go
new file mode 100644
index 0000000000000000000000000000000000000000..edb7acd5a955e2901f411df2ebd48935ea0ab56d
--- /dev/null
+++ b/transport/internet/splithttp/lifecycle.go
@@ -0,0 +1,224 @@
+// ExVPN changes: per-client HTTP resources and cancellation, 2026-10-17.
+// This file is part of Xray-core and is licensed under the MPL-2.0.
+package splithttp
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"syscall"
+
+	"github.com/apernet/quic-go"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+// clientResources owns sockets even when net/http detaches its dial context,
+// and an enumerable H1 upload pool. A retired client cannot publish a late dial.
+type clientResources struct {
+	mu       sync.Mutex
+	ctx      context.Context
+	cancel   context.CancelFunc
+	closed   bool
+	owned    map[io.Closer]struct{}
+	idleH1   []*H1Conn
+	pending  sync.WaitGroup
+	once     sync.Once
+	closeErr error
+}
+
+func newClientResources() *clientResources {
+	ctx, cancel := context.WithCancel(context.Background())
+	return &clientResources{ctx: ctx, cancel: cancel, owned: make(map[io.Closer]struct{})}
+}
+
+func (r *clientResources) begin() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return internet.ErrTransportClosed
+	}
+	r.pending.Add(1)
+	return nil
+}
+
+func (r *clientResources) context(parent context.Context) (context.Context, func()) {
+	ctx, cancel := context.WithCancel(parent)
+	stop := context.AfterFunc(r.ctx, cancel)
+	if r.ctx.Err() != nil {
+		cancel()
+	}
+	return ctx, func() { stop(); cancel() }
+}
+
+func (r *clientResources) add(c io.Closer) error {
+	r.mu.Lock()
+	if !r.closed {
+		r.owned[c] = struct{}{}
+		r.mu.Unlock()
+		return nil
+	}
+	r.mu.Unlock()
+	r.recordError(c.Close())
+	return internet.ErrTransportClosed
+}
+
+func (r *clientResources) recordError(err error) {
+	if err == nil || errors.Is(err, net.ErrClosed) {
+		return
+	}
+	r.mu.Lock()
+	r.closeErr = errors.Join(r.closeErr, err)
+	r.mu.Unlock()
+}
+
+func (r *clientResources) remove(c io.Closer) {
+	r.mu.Lock()
+	delete(r.owned, c)
+	r.mu.Unlock()
+}
+
+func (r *clientResources) trackConn(conn net.Conn) (net.Conn, error) {
+	c := &ownedHTTPConn{Conn: conn, owner: r}
+	if err := r.add(c); err != nil {
+		return nil, err
+	}
+	return c, nil
+}
+
+func (r *clientResources) trackPacket(conn net.PacketConn) (net.PacketConn, error) {
+	c := &ownedHTTPPacket{PacketConn: conn, owner: r}
+	if err := r.add(c); err != nil {
+		return nil, err
+	}
+	// quic-go selects UDP ancillary-data/ECN support through this optional
+	// interface. Preserve it without claiming that FakePacketConn supports OOB.
+	if oob, ok := conn.(quic.OOBCapablePacketConn); ok {
+		tracked := &ownedHTTPOOBPacket{ownedHTTPPacket: c, oob: oob}
+		if buffer, ok := conn.(interface{ SetWriteBuffer(int) error }); ok {
+			return &ownedHTTPBufferedOOBPacket{ownedHTTPOOBPacket: tracked, setWriteBuffer: buffer.SetWriteBuffer}, nil
+		}
+		return tracked, nil
+	}
+	return c, nil
+}
+
+func (r *clientResources) takeH1() (*H1Conn, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return nil, internet.ErrTransportClosed
+	}
+	if len(r.idleH1) == 0 {
+		return nil, nil
+	}
+	last := len(r.idleH1) - 1
+	c := r.idleH1[last]
+	r.idleH1[last] = nil
+	r.idleH1 = r.idleH1[:last]
+	return c, nil
+}
+
+func (r *clientResources) putH1(c *H1Conn) error {
+	r.mu.Lock()
+	if !r.closed {
+		r.idleH1 = append(r.idleH1, c)
+		r.mu.Unlock()
+		return nil
+	}
+	r.mu.Unlock()
+	_ = c.Close()
+	return internet.ErrTransportClosed
+}
+
+func (r *clientResources) close(closeTransport func() error) error {
+	r.once.Do(func() {
+		r.mu.Lock()
+		r.closed = true
+		r.cancel()
+		owned := make([]io.Closer, 0, len(r.owned))
+		for c := range r.owned {
+			owned = append(owned, c)
+		}
+		r.idleH1 = nil
+		r.mu.Unlock()
+		// Let QUIC send its connection-close frame while the packet socket is
+		// still open. The owned registry then closes active and raw sockets.
+		r.recordError(closeTransport())
+		// Close outside the registry mutex: tracked Close removes its entry.
+		for _, c := range owned {
+			r.recordError(c.Close())
+		}
+		// begin and publication are gated by the same mutex. Late dial results
+		// close themselves before ending; no Add can race this Wait.
+		r.pending.Wait()
+	})
+	return r.closeErr
+}
+
+type ownedHTTPConn struct {
+	net.Conn
+	owner *clientResources
+	once  sync.Once
+	err   error
+}
+
+func (c *ownedHTTPConn) Close() error {
+	c.once.Do(func() {
+		c.err = c.Conn.Close()
+		if c.err == nil || errors.Is(c.err, net.ErrClosed) {
+			c.owner.remove(c)
+		}
+	})
+	return c.err
+}
+
+type ownedHTTPPacket struct {
+	net.PacketConn
+	owner *clientResources
+	once  sync.Once
+	err   error
+}
+
+func (c *ownedHTTPPacket) Close() error {
+	c.once.Do(func() {
+		c.err = c.PacketConn.Close()
+		if c.err == nil || errors.Is(c.err, net.ErrClosed) {
+			c.owner.remove(c)
+		}
+	})
+	return c.err
+}
+
+type ownedHTTPOOBPacket struct {
+	*ownedHTTPPacket
+	oob quic.OOBCapablePacketConn
+}
+
+var _ quic.OOBCapablePacketConn = (*ownedHTTPOOBPacket)(nil)
+
+func (c *ownedHTTPOOBPacket) SyscallConn() (syscall.RawConn, error) {
+	return c.oob.SyscallConn()
+}
+
+func (c *ownedHTTPOOBPacket) SetReadBuffer(size int) error {
+	return c.oob.SetReadBuffer(size)
+}
+
+func (c *ownedHTTPOOBPacket) ReadMsgUDP(b, oob []byte) (int, int, int, *net.UDPAddr, error) {
+	return c.oob.ReadMsgUDP(b, oob)
+}
+
+func (c *ownedHTTPOOBPacket) WriteMsgUDP(b, oob []byte, addr *net.UDPAddr) (int, int, error) {
+	return c.oob.WriteMsgUDP(b, oob, addr)
+}
+
+type ownedHTTPBufferedOOBPacket struct {
+	*ownedHTTPOOBPacket
+	setWriteBuffer func(int) error
+}
+
+func (c *ownedHTTPBufferedOOBPacket) SetWriteBuffer(size int) error {
+	return c.setWriteBuffer(size)
+}
