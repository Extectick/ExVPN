+func TestExVPNTransportLifetimeRegisterCloseRace(t *testing.T) {
+	for round := 0; round < 100; round++ {
+		settings := new(MemoryStreamConfig)
+		lifetime := settings.Lifecycle()
+		var accepted, cleaned atomic.Int32
+		start := make(chan struct{})
+		var workers sync.WaitGroup
+		for i := 0; i < 12; i++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				<-start
+				err := lifetime.Register(func() error { cleaned.Add(1); return nil })
+				if err == nil {
+					accepted.Add(1)
+				} else if !errors.Is(err, ErrTransportClosed) {
+					t.Errorf("unexpected registration failure: %v", err)
+				}
+			}()
+		}
+		workers.Add(1)
+		go func() { defer workers.Done(); <-start; _ = settings.Close() }()
+		close(start)
+		workers.Wait()
+		if err := settings.Close(); err != nil || cleaned.Load() != accepted.Load() {
+			t.Fatalf("lost or duplicated cleanup: accepted=%d cleaned=%d err=%v", accepted.Load(), cleaned.Load(), err)
+		}
+	}
+}
