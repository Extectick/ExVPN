+func qaStartupFixture(t *testing.T) (*Handler, *qaStartupTun, *qaStartupDispatcher) {
+	t.Helper()
+	dispatcher := &qaStartupDispatcher{entered: make(chan struct{}), done: make(chan struct{})}
+	instance, err := core.New(&core.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = instance.Close() })
+	if err := instance.AddFeature(dispatcher); err != nil {
+		t.Fatal(err)
+	}
+	created, err := core.CreateObject(instance, &Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	handler := created.(*Handler)
+	t.Cleanup(func() { _ = handler.Close() })
+	tun := &qaStartupTun{qaMemoryTun: qaMemoryTun{endpoint: channel.New(8, 1500, "")}}
+	return handler, tun, dispatcher
+}
+
+func qaInjectStartupPacket(tun *qaStartupTun, dispatcher *qaStartupDispatcher) error {
+	data := []byte("memory-only startup witness")
+	raw := make([]byte, header.IPv4MinimumSize+header.UDPMinimumSize+len(data))
+	ip := header.IPv4(raw)
+	ip.Encode(&header.IPv4Fields{TotalLength: uint16(len(raw)), TTL: 64, Protocol: uint8(header.UDPProtocolNumber), SrcAddr: tcpip.AddrFrom4([4]byte{198, 18, 0, 1}), DstAddr: tcpip.AddrFrom4([4]byte{198, 18, 0, 2})})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	udp := header.UDP(raw[header.IPv4MinimumSize:])
+	udp.Encode(&header.UDPFields{SrcPort: 42001, DstPort: 53, Length: uint16(header.UDPMinimumSize + len(data))})
+	copy(raw[header.IPv4MinimumSize+header.UDPMinimumSize:], data)
+	packet := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(raw)})
+	tun.endpoint.InjectInbound(header.IPv4ProtocolNumber, packet)
+	packet.DecRef()
+	select {
+	case <-dispatcher.entered:
+		return nil
+	case <-time.After(time.Second):
+		return errors.New("startup worker positive control failed")
+	}
+}
