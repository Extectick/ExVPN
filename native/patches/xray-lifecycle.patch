+func TestExVPNGRPCLifetimeJoinsPendingDialAndClosesLateSocket(t *testing.T) {
+	client, peer := gonet.Pipe()
+	dialer := &delayedLifetimeDialer{entered: make(chan context.Context, 1), release: make(chan struct{}), conn: client}
+	settings := lifetimeConfig(false)
+	var release sync.Once
+	internet.UseAlternativeSystemDialer(dialer)
+	t.Cleanup(func() {
+		release.Do(func() { close(dialer.release) })
+		settings.Close()
+		peer.Close()
+		internet.UseAlternativeSystemDialer(nil)
+	})
+	_, err := getGrpcClient(context.Background(), net.TCPDestination(net.LocalHostIP, 1), settings)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var attempt context.Context
+	select {
+	case attempt = <-dialer.entered:
+	case <-time.After(time.Second):
+		t.Fatal("background dial did not start")
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- settings.Close() }()
+	select {
+	case <-attempt.Done():
+	case <-time.After(time.Second):
+		t.Fatal("pending dial did not receive owner cancellation")
+	}
+	select {
+	case <-closed:
+		t.Fatal("owner Close returned while a dial callback was still active")
+	case <-time.After(20 * time.Millisecond):
+	}
+	release.Do(func() { close(dialer.release) })
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("owner did not join released callback")
+	}
+	peer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := peer.Read(make([]byte, 1)); !errors.Is(err, io.EOF) {
+		t.Fatal("late dial socket survived retirement", err)
+	}
+	if dialer.calls.Load() != 1 || grpcOwnerPresent(settings) {
+		t.Fatal("retired owner restarted dial or retained cache")
