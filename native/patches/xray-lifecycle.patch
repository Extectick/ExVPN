+func TestExVPNBodyCloseJoinsConcurrentRetirementAndRetainsErrors(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(strconv.FormatBool(fail), func(t *testing.T) {
+			resources := newClientResources()
+			body := &exVPNBlockingBody{entered: make(chan struct{}), release: make(chan struct{})}
+			var release sync.Once
+			defer release.Do(func() { close(body.release) })
+			if fail {
+				body.err = errors.New("synthetic response close failure")
+			}
+			cancelled := make(chan struct{})
+			reader := &WaitReadCloser{wait: done.New(), owner: resources, onClose: func() error { close(cancelled); return nil }}
+			if err := resources.add(reader); err != nil {
+				t.Fatal(err)
+			}
+			reader.Set(body)
+			first, second, retirement := make(chan error, 1), make(chan error, 1), make(chan error, 1)
+			go func() { first <- reader.Close() }()
+			waitExVPN(t, body.entered, "response body close not entered")
+			waitExVPN(t, cancelled, "request was not cancelled before body close")
+			resources.mu.Lock()
+			retained := len(resources.owned)
+			resources.mu.Unlock()
+			if retained != 1 {
+				t.Fatal("pending body close was forgotten before it completed")
+			}
+			retiring := make(chan struct{})
+			go func() { retirement <- resources.close(func() error { close(retiring); return nil }) }()
+			waitExVPN(t, retiring, "retirement did not start")
+			go func() { second <- reader.Close() }()
+			select {
+			case <-second:
+				t.Fatal("concurrent body Close returned before cleanup completed")
+			case <-retirement:
+				t.Fatal("retirement returned before body cleanup completed")
+			case <-time.After(20 * time.Millisecond):
+			}
+			release.Do(func() { close(body.release) })
+			for _, result := range []<-chan error{first, second, retirement} {
+				select {
+				case err := <-result:
+					if !errors.Is(err, body.err) {
+						t.Fatal("body cleanup result was not preserved")
+					}
+				case <-time.After(3 * time.Second):
+					t.Fatal("body cleanup did not join")
+				}
+			}
+			if body.calls.Load() != 1 {
+				t.Fatal("response body was closed more than once")
+			}
+			if err := resources.close(func() error { return nil }); !errors.Is(err, body.err) {
+				t.Fatal("repeat retirement changed the body cleanup result")
+			}
+		})
+	}
+}
