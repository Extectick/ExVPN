+func TestExVPNTransportLifetimeCacheLockOrder(t *testing.T) {
+	settings := new(MemoryStreamConfig)
+	var cache sync.Mutex
+	cache.Lock()
+	removed := false
+	if err := settings.Lifecycle().Register(func() error {
+		cache.Lock()
+		defer cache.Unlock()
+		removed = true
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- settings.Close() }()
+	select {
+	case <-settings.Lifecycle().Context().Done():
+	case <-time.After(time.Second):
+		t.Fatal("retirement held lifetime lock while waiting on cache")
+	}
+	if err := settings.Lifecycle().Register(func() error { return nil }); !errors.Is(err, ErrTransportClosed) {
+		t.Fatal("retired cache owner accepted publication")
+	}
+	cache.Unlock()
+	select {
+	case err := <-closed:
+		if err != nil || !removed {
+			t.Fatal("cache cleanup failed", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cache/lifetime lock inversion")
+	}
+}
