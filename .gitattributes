* text=auto eol=lf

# Preserve the established raw notice bytes while source checkouts use LF.
native/windows/licenses/Microsoft-Visual-Studio-2026-Community.txt text eol=crlf
native/windows/licenses/NSIS-3.13.txt text eol=crlf
native/windows/licenses/Wintun-0.14.1-binary.txt text eol=crlf
apps/exvpn/android/licenses/Hamcrest-1.3.txt text eol=crlf
scripts/release/licenses/7zip-26.04.txt text eol=crlf

# Checksummed patch bytes must be identical on Windows and CI checkouts.
native/patches/*.patch text eol=lf -whitespace
native/patches/*.json text eol=lf
scripts/release/shorebird-updater-notices-crates.lock.json -text -whitespace

# Flutter regenerates these tracked files using LF even on Windows. Explicit
# checkout bytes keep a fresh pub get clean without ignoring plugin changes.
apps/exvpn/linux/flutter/generated_plugin_registrant.cc text eol=lf
apps/exvpn/linux/flutter/generated_plugin_registrant.h text eol=lf
apps/exvpn/linux/flutter/generated_plugins.cmake text eol=lf
apps/exvpn/windows/flutter/generated_plugin_registrant.cc text eol=lf
apps/exvpn/windows/flutter/generated_plugin_registrant.h text eol=lf
apps/exvpn/windows/flutter/generated_plugins.cmake text eol=lf

# Keep upstream OFL notices byte-for-byte, including their original whitespace.
apps/exvpn/assets/fonts/NotoSansArabic-OFL.txt -text -whitespace
apps/exvpn/assets/fonts/NotoSansSC-OFL.txt -text -whitespace
